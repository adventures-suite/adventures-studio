<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
  <None Update="Content/**/*.json">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
  </None>
</ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.3" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.3" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AdventuresSuite.Identity" />
    <Using Include="AdventuresSuite.Identity.Persistence" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AdventuresSuite.Planning/AdventuresSuite.Planning.csproj" />
    <ProjectReference Include="../AdventuresSuite.Planning.SqlServer/AdventuresSuite.Planning.SqlServer.csproj" />
    <ProjectReference Include="../AdventuresSuite.Authorization/AdventuresSuite.Authorization.csproj" />
    <ProjectReference Include="../AdventuresSuite.Authorization.SqlServer/AdventuresSuite.Authorization.SqlServer.csproj" />
    <ProjectReference Include="../AdventuresSuite.Identity/AdventuresSuite.Identity.csproj" />
    <ProjectReference Include="../AdventuresSuite.Identity.ExternalId/AdventuresSuite.Identity.ExternalId.csproj" />
    <ProjectReference Include="../AdventuresSuite.Identity.SqlServer/AdventuresSuite.Identity.SqlServer.csproj" />
  </ItemGroup>

</Project>
