<section class="home-hero">
    <div class="home-hero__media">
        <img src="@HeroImage"
             alt="@HeroImageAlt" />

        <div class="home-hero__overlay"></div>
    </div>

    <div class="home-hero__content">
        <span class="home-hero__eyebrow">
            @Eyebrow
        </span>

        <h1>
            @Headline
        </h1>

        <p>@Description</p>

        <a class="home-hero__action"
           href="@PrimaryActionUrl">
            @PrimaryActionLabel
            <span aria-hidden="true">→</span>
        </a>
    </div>
</section>

@code {
    /// <summary>Gets or sets the Creator name shown above the hero heading.</summary>
    [Parameter]
    public string Eyebrow { get; set; } = string.Empty;

    /// <summary>Gets or sets the Creator-owned hero headline.</summary>
    [Parameter]
    public string Headline { get; set; } = string.Empty;

    /// <summary>Gets or sets the Creator-owned hero description.</summary>
    [Parameter]
    public string Description { get; set; } = string.Empty;

    /// <summary>Gets or sets the background image shown by the homepage hero.</summary>
    [Parameter]
    public string HeroImage { get; set; } = string.Empty;

    /// <summary>Gets or sets accessible alternative text for the hero image.</summary>
    [Parameter]
    public string HeroImageAlt { get; set; } = string.Empty;

    /// <summary>Gets or sets the Creator-owned primary action label.</summary>
    [Parameter]
    public string PrimaryActionLabel { get; set; } = string.Empty;

    /// <summary>Gets or sets the route opened by the primary hero action.</summary>
    [Parameter]
    public string PrimaryActionUrl { get; set; } = string.Empty;
}
