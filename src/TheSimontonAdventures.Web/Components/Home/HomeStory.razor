@inject ICreatorContextAccessor CreatorContextAccessor

<section id="our-story" class="home-story">
    <div class="home-story__content">
        <div class="home-story__copy">
            <p class="home-story__eyebrow">Our Story</p>

            <h2>Travel has always been about more than the destination.</h2>

            <p class="home-story__lead">
                It is about slowing down, learning from history, meeting remarkable
                people, sharing unforgettable moments, and creating memories together.
            </p>

            <p>
                @CreatorContextAccessor.Current.GetSiteName() began as a way to preserve those memories.
                Over time, it became something more: a collection of stories,
                photography, reflections, and resources designed to inspire others
                to begin journeys of their own.
            </p>

            @if (!string.IsNullOrWhiteSpace(Signature))
            {
                <p class="home-story__signature">@Signature</p>
            }
        </div>

        <figure class="home-story__media">
            <img src="@ImageUrl"
                 alt="@ImageAlt"
                 loading="lazy" />

            <figcaption>
                Sharing the journey, one adventure at a time.
            </figcaption>
        </figure>
    </div>
</section>

@code {
    /// <summary>Gets or sets the optional Creator-authored signature.</summary>
    [Parameter]
    public string Signature { get; set; } = string.Empty;

    /// <summary>Gets or sets the Creator-authored story image URL.</summary>
    [Parameter]
    public string ImageUrl { get; set; } = "/images/home/our-story.jpeg";

    /// <summary>Gets or sets accessible alternative text for the story image.</summary>
    [Parameter]
    public string ImageAlt { get; set; } = "Creators sharing a memorable journey";
}
