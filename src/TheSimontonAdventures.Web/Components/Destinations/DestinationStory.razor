@using TheSimontonAdventures.Web.Models

@if (Sections.Count > 0)
{
    <div class="destination-story">
        @for (var index = 0; index < Sections.Count; index++)
        {
            var section = Sections[index];
            var sectionNumber = index + 1;
            var hasImage = !string.IsNullOrWhiteSpace(section.ResolvedImageUrl);
            var isReversed = index % 2 == 1;

            <section class="destination-story__section
                            @(hasImage ? "destination-story__section--with-image" : string.Empty)
                            @(isReversed ? "destination-story__section--reversed" : string.Empty)">

                <div class="destination-story__heading">
                    <span class="destination-story__number">
                        @sectionNumber.ToString("00")
                    </span>

                    <h2>@section.Heading</h2>
                </div>

                <div class="destination-story__body">
                    @foreach (var paragraph in section.Paragraphs)
                    {
                        <p>@paragraph</p>
                    }
                </div>

                @if (hasImage)
                {
                    <figure class="destination-story__media">
                        <img src="@section.ResolvedImageUrl"
                             alt="@section.ResolvedImageAlternativeText"
                             loading="lazy" />

                        @if (!string.IsNullOrWhiteSpace(section.ImageCaption))
                        {
                            <figcaption>
                                @section.ImageCaption
                            </figcaption>
                        }
                    </figure>
                }

                @foreach (var reflection in Reflections
                    .Where(item => item.AfterSection == sectionNumber))
                {
                    <DestinationReflection Reflection="reflection" />
                }
            </section>
        }
    </div>
}

@code {
    /// <summary>Gets or sets the ordered sections that form the story.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<DestinationSection> Sections { get; set; }
        = Array.Empty<DestinationSection>();

    /// <summary>
    /// Gets or sets reflections inserted after their configured story sections.
    /// </summary>
    [Parameter]
    public IReadOnlyList<JourneyReflection> Reflections { get; set; }
        = Array.Empty<JourneyReflection>();
}
