@using TheSimontonAdventures.Web.Models

@if (Sections.Count > 0)
{
    <div class="destination-story">
        @for (var index = 0; index < Sections.Count; index++)
        {
            var section = Sections[index];

            <section class="destination-story__section">
                <div class="destination-story__heading">
                    <span class="destination-story__number">
                        @(index + 1 < 10 ? $"0{index + 1}" : $"{index + 1}")
                    </span>

                    <h2>@section.Heading</h2>
                </div>

                <div class="destination-story__body">
                    @foreach (var paragraph in section.Paragraphs)
                    {
                        <p>@paragraph</p>
                    }
                </div>
            </section>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<DestinationSection> Sections { get; set; }
        = Array.Empty<DestinationSection>();
}