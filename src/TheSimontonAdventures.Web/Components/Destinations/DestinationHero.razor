@using TheSimontonAdventures.Web.Models

<section class="destination-hero"
         style="@GetBackgroundStyle()"
         aria-label="@HeroImageAlt">

    <div class="destination-hero__overlay"></div>

    <div class="destination-hero__content">
        <p class="destination-hero__location">
            @Destination.City · @Destination.Country
        </p>

        <h1>@Destination.Title</h1>

        <p class="destination-hero__subtitle">
            @Destination.Subtitle
        </p>
    </div>

    <a class="destination-hero__scroll"
       href="#destination-story">
        <span>Begin the story</span>
        <span class="destination-hero__scroll-line"
              aria-hidden="true"></span>
    </a>
</section>

@code {
    /// <summary>Gets or sets the destination presented by the hero.</summary>
    [Parameter, EditorRequired]
    public Destination Destination { get; set; } = null!;

    /// <summary>Gets or sets the Resource Engine-resolved hero image URL.</summary>
    [Parameter]
    public string HeroImageUrl { get; set; } = string.Empty;

    /// <summary>Gets or sets authoritative Resource Engine alternative text.</summary>
    [Parameter]
    public string HeroImageAlt { get; set; } = string.Empty;

    private string GetBackgroundStyle() =>
        string.IsNullOrWhiteSpace(HeroImageUrl)
            ? string.Empty
            : $"background-image: url('{HeroImageUrl}');";
}
