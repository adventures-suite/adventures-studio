@using TheSimontonAdventures.Web.Models
@using TheSimontonAdventures.Web.Services
@inject ITravelContentService TravelContentService

@if (_previous is not null || _next is not null)
{
    <nav class="destination-navigation"
         aria-label="Destination navigation">

        <div class="destination-navigation__content">
            @if (_previous is not null)
            {
                <a class="destination-navigation__item destination-navigation__item--previous"
                   href="@GetDestinationUrl(_previous)">
                    <span>← Previous destination</span>
                    <strong>@_previous.Title</strong>
                </a>
            }
            else
            {
                <span></span>
            }

            @if (_next is not null)
            {
                <a class="destination-navigation__item destination-navigation__item--next"
                   href="@GetDestinationUrl(_next)">
                    <span>Next destination →</span>
                    <strong>@_next.Title</strong>
                </a>
            }
        </div>
    </nav>
}

@code {
    [Parameter, EditorRequired]
    public Destination Destination { get; set; } = null!;

    private Destination? _previous;
    private Destination? _next;

    protected override async Task OnParametersSetAsync()
    {
        _previous = null;
        _next = null;

        var volume = await TravelContentService.GetVolumeAsync(
            Destination.VolumeSlug);

        if (volume is null)
        {
            return;
        }

        var destinations = volume.Destinations
            .OrderBy(item => item.DisplayOrder)
            .ToList();

        var currentIndex = destinations.FindIndex(item =>
            string.Equals(
                item.CountrySlug,
                Destination.CountrySlug,
                StringComparison.OrdinalIgnoreCase)
            && string.Equals(
                item.DestinationSlug,
                Destination.Slug,
                StringComparison.OrdinalIgnoreCase));

        if (currentIndex < 0)
        {
            return;
        }

        if (currentIndex > 0)
        {
            var previousReference = destinations[currentIndex - 1];

            _previous = await TravelContentService.GetDestinationAsync(
                Destination.VolumeSlug,
                previousReference.CountrySlug,
                previousReference.DestinationSlug);
        }

        if (currentIndex < destinations.Count - 1)
        {
            var nextReference = destinations[currentIndex + 1];

            _next = await TravelContentService.GetDestinationAsync(
                Destination.VolumeSlug,
                nextReference.CountrySlug,
                nextReference.DestinationSlug);
        }
    }

    private static string GetDestinationUrl(Destination destination)
    {
        return $"/volumes/{destination.VolumeSlug}/" +
               $"{destination.CountrySlug}/{destination.Slug}";
    }
}