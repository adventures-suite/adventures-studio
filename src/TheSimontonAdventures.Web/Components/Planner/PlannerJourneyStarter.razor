@namespace TheSimontonAdventures.Web.Components

<section class="journey-starter" aria-labelledby="journey-starter-title">
    <p class="journey-starter__eyebrow">Begin with confidence</p>
    <h2 id="journey-starter-title">Start a journey</h2>
    <p>Choose the starting point that fits how much you already know.</p>

    <div class="journey-starter__choices" aria-label="Journey starting options">
        <button type="button" class="journey-starter__choice" aria-pressed="@(!IsBrowsingIdeas)" @onclick="StartFromScratchAsync">
            <span aria-hidden="true">＋</span>
            <strong>Start from scratch</strong>
            <small>Build a private plan from your own dates and inspiration.</small>
        </button>
        <button type="button" class="journey-starter__choice" aria-pressed="@IsBrowsingIdeas" @onclick="BrowseIdeasAsync">
            <span aria-hidden="true">✦</span>
            <strong>Browse Journey FootSteps</strong>
            <small>Preview a complete Journey before creating your private copy.</small>
        </button>
    </div>

    @if (IsBrowsingIdeas)
    {
        <div class="journey-starter__browser">
            <div>
                <p class="journey-starter__eyebrow">Journey FootSteps</p>
                <h3>Find a shape for your Adventure</h3>
                <p>FootSteps are starting points, not bookings, prices, or availability.</p>
            </div>
            @if (Templates.Count > 0)
            {
                <ul class="journey-starter__ideas">
                    @foreach (var template in PagedTemplates)
                    {
                        <li>
                            <article class="journey-starter__idea">
                                <div class="journey-starter__thumbnail" aria-hidden="true">@Monogram(template.Title)</div>
                                <p class="journey-starter__eyebrow">Journey FootStep</p>
                                <h4>@template.Title</h4>
                                <p>@template.WorkingDescription</p>
                                <p class="journey-starter__route">@Route(template)</p>
                                <p class="journey-starter__attribution">By @template.Attribution</p>
                                <ul class="journey-starter__tags" aria-label="FootStep details">
                                    @foreach (var tag in DiscoveryTags(template))
                                    {
                                        <li>@tag</li>
                                    }
                                </ul>
                                <button type="button"
                                        aria-expanded="@(SelectedTemplate?.VersionId == template.VersionId)"
                                        aria-controls="journey-template-preview"
                                        @onclick="() => PreviewTemplate(template)">Configure Journey</button>
                            </article>
                        </li>
                    }
                </ul>
                <PlannerIdeaPager TotalItems="@Templates.Count"
                                  PageSize="@PageSize"
                                  CurrentPage="@CurrentPage"
                                  PageSizeOptions="@JourneyPageSizeOptions"
                                  OnPageSizeChanged="ChangePageSizeAsync"
                                  OnPageChanged="ChangePageAsync" />
                @if (SelectedTemplate is not null)
                {
                    <section id="journey-template-preview" class="journey-template" aria-labelledby="journey-template-title">
                        <header class="journey-template__header">
                            <div>
                                <p class="journey-starter__eyebrow">Journey FootStep setup</p>
                                <h3 id="journey-template-title">@SelectedTemplate.Title</h3>
                                <p>@SelectedTemplate.WorkingDescription</p>
                            </div>
                            <dl>
                                <div><dt>Duration</dt><dd>@SelectedTemplate.DurationDays days</dd></div>
                                <div><dt>Source</dt><dd>@SelectedTemplate.Attribution</dd></div>
                                <div><dt>Version</dt><dd>@SelectedTemplate.VersionId.Version</dd></div>
                            </dl>
                        </header>

                        <ol class="journey-template__progress" aria-label="Journey creation progress">
                            <li class="is-complete">Choose</li>
                            <li class="@(IsReviewReady ? "is-complete" : "is-current")">Configure</li>
                            <li class="@(IsReviewReady ? "is-current" : null)">Review</li>
                            <li>Create</li>
                        </ol>

                        <div class="journey-template__sections" aria-label="FootStep contents">
                            <section aria-labelledby="template-destinations">
                                <h4 id="template-destinations">Destinations</h4>
                                <ol class="journey-template__plain-list">
                                    @foreach (var destination in SelectedTemplate.Destinations)
                                    {
                                        <li><strong>@TemplateDestinationName(destination)</strong><span>@destination.Guidance</span></li>
                                    }
                                </ol>
                            </section>
                            <section aria-labelledby="template-itinerary">
                                <h4 id="template-itinerary">Itinerary</h4>
                                <ol class="journey-template__days">
                                    @foreach (var day in SelectedTemplate.Days)
                                    {
                                        <li><strong>Day @(day.DayOffset + 1): @day.Title</strong></li>
                                    }
                                </ol>
                            </section>
                            @if (SelectedTemplate.Activities.Count > 0)
                            {
                                <section aria-labelledby="template-activities">
                                    <h4 id="template-activities">Activity FootSteps</h4>
                                    <ul class="journey-template__plain-list">
                                        @foreach (var activity in SelectedTemplate.Activities)
                                        {
                                            <li><strong>@activity.Title</strong><span>Proposed FootStep, not a reservation</span></li>
                                        }
                                    </ul>
                                </section>
                            }
                            <section aria-labelledby="template-travel">
                                <h4 id="template-travel">Travel methods</h4>
                                <ul class="journey-template__plain-list">
                                    @foreach (var segment in SelectedTemplate.Transportation)
                                    {
                                        <li><strong>@segment.From → @segment.To</strong><span>@segment.Mode · proposed, not booked</span></li>
                                    }
                                </ul>
                            </section>
                            <section aria-labelledby="template-stays">
                                <h4 id="template-stays">Stay patterns</h4>
                                <ul class="journey-template__plain-list">
                                    @foreach (var stay in SelectedTemplate.Accommodations)
                                    {
                                        <li><strong>@stay.Name</strong><span>Proposed pattern, not a reservation</span></li>
                                    }
                                </ul>
                            </section>
                        </div>

                        <div class="journey-template__boundary">
                            <p><strong>Your private copy.</strong> Creating this Journey copies the complete template into a new plan owned by your Creator.</p>
                            <p>Nothing is booked. Later template changes cannot alter your plan, and the template author receives no access.</p>
                        </div>
                        <section class="journey-template__configuration" aria-labelledby="journey-configuration-title">
                            <div>
                                <p class="journey-starter__eyebrow">Configure</p>
                                <h4 id="journey-configuration-title">When does your Journey begin?</h4>
                                @if (SelectedTemplate.RequiresConfiguredOrigin)
                                {
                                    <p>This FootStep has a fixed destination stay. Your reviewed travel assumptions add realistic riding days before and after it.</p>
                                }
                                else
                                {
                                    <p>This FootStep has a fixed @SelectedTemplate.DurationDays-day shape. You can adjust its copied details after creation.</p>
                                }
                            </div>
                            @if (SelectedTemplate.RequiresConfiguredOrigin)
                            {
                                <div class="journey-template__origin-fields">
                                    <label>
                                        Starting place
                                        <input type="text"
                                               @bind="OriginName"
                                               @bind:event="oninput"
                                               @bind:after="ConfigurationChanged"
                                               maxlength="200"
                                               placeholder="City, state or region"
                                               autocomplete="off" />
                                    </label>
                                    <label>
                                        Starting time zone
                                        <select @bind="OriginTimeZone" @bind:after="ConfigurationChanged">
                                            <option value="">Choose a time zone</option>
                                            @foreach (var option in OriginTimeZoneOptions)
                                            {
                                                <option value="@option.Value">@option.Label</option>
                                            }
                                        </select>
                                    </label>
                                </div>
                                <p class="journey-template__after">Your starting place becomes part of the copied route. It is not shared with the FootStep author.</p>
                                <div class="journey-template__origin-fields">
                                    <label>
                                        Estimated one-way distance
                                        <span class="journey-template__input-unit">
                                            <input type="number"
                                                   @bind="OneWayDistanceMiles"
                                                   @bind:event="oninput"
                                                   @bind:after="ConfigurationChanged"
                                                   min="25"
                                                   max="10000"
                                                   step="25" />
                                            <span>miles</span>
                                        </span>
                                    </label>
                                    <label>
                                        Daily riding target
                                        <select @bind="DailyDistanceMiles" @bind:after="ConfigurationChanged">
                                            <option value="300">Relaxed · about 300 miles</option>
                                            <option value="450">Balanced · about 450 miles</option>
                                            <option value="600">Ambitious · about 600 miles</option>
                                        </select>
                                    </label>
                                </div>
                                <p class="journey-template__travel-estimate">
                                    Plan for <strong>@TravelDaysEachWay riding days each way</strong>.
                                    This is a reviewed planning estimate, not live routing or safety guidance.
                                </p>
                            }
                            <label>
                                Start date
                                <input type="date"
                                       value="@StartDateText"
                                       aria-describedby="journey-start-date-guidance"
                                       @oninput="StartDateChanged" />
                            </label>
                            <p id="journey-start-date-guidance" class="journey-template__after">Dates below will be calculated before anything is created.</p>
                            @if (!string.IsNullOrEmpty(StartDateError))
                            {
                                <p class="journey-template__validation" role="alert">@StartDateError</p>
                            }
                            <button type="button"
                                    class="journey-template__continue"
                                    disabled="@(!IsConfigurationComplete)"
                                    @onclick="ReviewConfiguration">Review configured Journey</button>
                        </section>

                        @if (IsReviewReady && ConfiguredStartDate.HasValue)
                        {
                            <section class="journey-template__review" aria-labelledby="journey-review-title">
                                <header>
                                    <div>
                                        <p class="journey-starter__eyebrow">Review before creation</p>
                                        <h4 id="journey-review-title">Your dated Journey</h4>
                                    </div>
                                    <p><strong>@FormatDate(ConfiguredStartDate.Value)</strong> – <strong>@FormatDate(JourneyEndDate)</strong></p>
                                </header>
                                <ol class="journey-template__dated-route">
                                    @foreach (var destination in SelectedTemplate.Destinations)
                                    {
                                        <li>
                                            <span>@ConfiguredDestinationName(destination)</span>
                                            <small>@FormatDate(ConfiguredStartDate.Value.AddDays(AdaptedOffset(destination.StartDayOffset))) – @FormatDate(ConfiguredStartDate.Value.AddDays(AdaptedOffset(destination.EndDayOffset)))</small>
                                        </li>
                                    }
                                </ol>
                                <dl class="journey-template__review-counts">
                                    <div><dt>Destinations</dt><dd>@SelectedTemplate.Destinations.Count</dd></div>
                                    <div><dt>Itinerary days</dt><dd>@AdaptedItineraryDayCount</dd></div>
                                    <div><dt>Activities</dt><dd>@SelectedTemplate.Activities.Count</dd></div>
                                    <div><dt>Travel legs</dt><dd>@SelectedTemplate.Transportation.Count</dd></div>
                                    @if (SelectedTemplate.RequiresConfiguredOrigin)
                                    {
                                        <div><dt>Riding days</dt><dd>@RidingDayCount</dd></div>
                                    }
                                    <div><dt>Stay patterns</dt><dd>@SelectedTemplate.Accommodations.Count</dd></div>
                                </dl>
                                <form method="post" action="@CreateFromTemplatePath" class="journey-template__create">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="idempotencyKey" value="@IdempotencyKey(SelectedTemplate.VersionId)" />
                                    <input type="hidden" name="templateId" value="@SelectedTemplate.VersionId.TemplateId" />
                                    <input type="hidden" name="templateVersion" value="@SelectedTemplate.VersionId.Version" />
                                    <input type="hidden" name="locale" value="@Locale" />
                                    <input type="hidden" name="startDate" value="@StartDateText" />
                                    @if (SelectedTemplate.RequiresConfiguredOrigin)
                                    {
                                        <input type="hidden" name="originName" value="@OriginName" />
                                        <input type="hidden" name="originTimeZone" value="@OriginTimeZone" />
                                        <input type="hidden" name="oneWayDistanceMiles" value="@OneWayDistanceMiles" />
                                        <input type="hidden" name="dailyDistanceMiles" value="@DailyDistanceMiles" />
                                    }
                                    <button type="button" class="journey-template__secondary" @onclick="ChangeConfiguration">Change start date</button>
                                    <button type="submit" class="journey-template__continue">Create my private Journey</button>
                                </form>
                                <p class="journey-template__after">After creation, adjust destinations, dates, itinerary items, transportation, and stays in your private plan.</p>
                            </section>
                        }
                    </section>
                }
            }
            else
            {
                <PlannerWorkspaceState Kind="PlannerWorkspaceStateKind.Empty"
                                       Title="Journey FootSteps are coming soon"
                                       Message="Start from scratch remains available while the reviewed library is prepared." />
            }
        </div>
    }
</section>
