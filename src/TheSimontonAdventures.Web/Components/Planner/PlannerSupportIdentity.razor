@namespace TheSimontonAdventures.Web.Components

<aside class="planner-support-identity" aria-labelledby="planner-support-identity-title">
    <p class="planner-support-identity__eyebrow">Account support</p>
    <h2 id="planner-support-identity-title">Your AdventuresSuite user ID</h2>
    <p>Provide this identifier when AdventuresSuite support needs to connect your signed-in account to an approved Creator workspace.</p>
    <output aria-label="Your AdventuresSuite user ID">@UserId</output>
    <p class="planner-support-identity__privacy">This identifies only your signed-in platform account. It does not grant access by itself.</p>
</aside>
