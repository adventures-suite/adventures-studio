@namespace TheSimontonAdventures.Web.Components

<aside id="planner-workspace-sidebar"
       class="@SidebarClasses"
       aria-label="Planner navigation"
       data-collapsed="@IsCollapsed"
       data-mobile-open="@IsMobileOpen"
       @onpointermove="ContinuePointerResizeAsync"
       @onpointerup="EndPointerResize"
       @onpointercancel="EndPointerResize"
       @onpointerleave="EndPointerResize">
    <div class="planner-sidebar__header">
        <div class="planner-sidebar__brand">
            @if (!IsCollapsed)
            {
                <svg class="planner-sidebar__brand-mark" viewBox="0 0 32 32" role="img" aria-labelledby="planner-brand-title">
                    <title id="planner-brand-title">AdventuresSuite Planner</title>
                    <path d="M5 26 16 5l11 21M10 18h12" />
                </svg>
                <span class="planner-sidebar__brand-name">AdventuresSuite</span>
            }
        </div>

        <button type="button"
                class="planner-sidebar__collapse-toggle"
                aria-label="@(IsCollapsed ? "Expand Planner navigation" : "Collapse Planner navigation")"
                title="@(IsCollapsed ? "Expand navigation" : "Collapse navigation")"
                aria-expanded="@(!IsCollapsed ? "true" : "false")"
                @onclick="OnCollapseRequested">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="@(IsCollapsed ? "m9 5 7 7-7 7" : "m15 5-7 7 7 7")" /></svg>
        </button>

        <button type="button"
                class="planner-sidebar__mobile-close"
                aria-label="Close Planner navigation"
                @onclick="OnMobileCloseRequested">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18" /></svg>
        </button>
    </div>

    <nav class="planner-sidebar__nav" aria-label="Planner navigation">
        <a class="@(ActiveApplicationSlug == "planner" ? "planner-sidebar__current" : null)"
           href="@PlannerPath"
           aria-current="@(ActiveApplicationSlug == "planner" ? "page" : null)"
           title="Planner">
            <svg class="planner-sidebar__icon" viewBox="0 0 24 24" role="img" aria-labelledby="planner-overview-title">
                <title id="planner-overview-title">Planner overview</title>
                <path d="M3 12.5 12 4l9 8.5v7.5a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z" />
            </svg>
            @if (!IsCollapsed)
            {
                <span>Planner</span>
            }
        </a>
        <div class="planner-sidebar__applications" aria-label="AdventuresSuite applications">
            <a href="@ApplicationPath("advisor")" aria-current="@(ActiveApplicationSlug == "advisor" ? "page" : null)" title="Advisor">
                <svg class="planner-sidebar__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M12 3a7 7 0 0 0-4 12.7V20l4-2 4 2v-4.3A7 7 0 0 0 12 3Z" />
                    <path d="m9.5 10.5 1.5 1.5 3.5-3.5" />
                </svg>
                @if (!IsCollapsed) { <span>Advisor</span> }
            </a>
            <a href="@ApplicationPath("companion")" aria-current="@(ActiveApplicationSlug == "companion" ? "page" : null)" title="Companion">
                <svg class="planner-sidebar__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <rect x="7" y="2.5" width="10" height="19" rx="2" />
                    <path d="M10 5h4M11 18.5h2" />
                </svg>
                @if (!IsCollapsed) { <span>Companion</span> }
            </a>
            <a href="@ApplicationPath("publisher")" aria-current="@(ActiveApplicationSlug == "publisher" ? "page" : null)" title="Publisher">
                <svg class="planner-sidebar__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M4 4h10a3 3 0 0 1 3 3v13H7a3 3 0 0 1-3-3Z" />
                    <path d="M7 8h6M7 12h6M17 8h3v12h-3" />
                </svg>
                @if (!IsCollapsed) { <span>Publisher</span> }
            </a>
            <a href="@ApplicationPath("web")" aria-current="@(ActiveApplicationSlug == "web" ? "page" : null)" title="Web">
                <svg class="planner-sidebar__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18" />
                </svg>
                @if (!IsCollapsed) { <span>Web</span> }
            </a>
            <a href="@ApplicationPath("search")" aria-current="@(ActiveApplicationSlug == "search" ? "page" : null)" title="Search">
                <svg class="planner-sidebar__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <circle cx="10.5" cy="10.5" r="6.5" />
                    <path d="m15.5 15.5 5 5" />
                </svg>
                @if (!IsCollapsed) { <span>Search</span> }
            </a>
            <a href="@ApplicationPath("maps")" aria-current="@(ActiveApplicationSlug == "maps" ? "page" : null)" title="Maps">
                <svg class="planner-sidebar__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3Z" />
                    <path d="M9 3v15M15 6v15" />
                </svg>
                @if (!IsCollapsed) { <span>Maps</span> }
            </a>
        </div>
    </nav>

    <div class="planner-sidebar__controls" aria-label="Navigation panel controls">
        <button type="button" aria-label="Hide Planner navigation" title="Hide navigation" @onclick="OnHideRequested">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 12h18M7 8l-4 4 4 4" /></svg>
        </button>
    </div>

    @if (!IsCollapsed)
    {
        <div class="planner-sidebar__resize-controls" aria-label="Navigation width controls">
            <button type="button"
                    aria-label="Narrow Planner navigation"
                    disabled="@(WidthPixels <= MinimumWidthPixels)"
                    @onclick="DecreaseWidthAsync">−</button>
            <span aria-hidden="true">Width</span>
            <button type="button"
                    aria-label="Widen Planner navigation"
                    disabled="@(WidthPixels >= MaximumWidthPixels)"
                    @onclick="IncreaseWidthAsync">+</button>
        </div>

        <div class="planner-sidebar__separator"
             role="separator"
             aria-label="Resize Planner navigation"
             aria-orientation="vertical"
             aria-valuemin="@MinimumWidthPixels"
             aria-valuemax="@MaximumWidthPixels"
             aria-valuenow="@WidthPixels"
             tabindex="0"
             @onkeydown="HandleResizeKeyAsync"
             @onpointerdown="BeginPointerResizeAsync"
             @onpointerdown:preventDefault="true"></div>
    }
</aside>
