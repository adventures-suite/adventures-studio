@namespace TheSimontonAdventures.Web.Components

<button type="button" class="planner-ideas__mobile-open" @ref="OpenButton" aria-haspopup="dialog" @onclick="OpenDrawerAsync">FootSteps</button>
<aside class="@RailClasses" @ref="RailElement" role="@(IsDrawerOpen ? "dialog" : "complementary")" aria-modal="@(IsDrawerOpen ? "true" : null)" aria-labelledby="planner-ideas-title" @onkeydown="HandleKeyAsync">
    <header class="planner-ideas__header">
        <div><h3 id="planner-ideas-title">FootSteps</h3></div>
        <div class="planner-ideas__controls">
            <button type="button"
                    class="planner-ideas__collapse"
                    aria-label="@(IsCollapsed ? "Expand FootSteps rail" : "Collapse FootSteps rail")"
                    title="@(IsCollapsed ? "Expand FootSteps rail" : "Collapse FootSteps rail")"
                    aria-expanded="@(!IsCollapsed)"
                    @onclick="ToggleCollapsed">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="@(IsCollapsed ? "m15 5-7 7 7 7" : "m9 5 7 7-7 7")" />
                </svg>
            </button>
            <button type="button" class="planner-ideas__close" @ref="CloseButton" @onclick="CloseDrawerAsync">Close</button>
        </div>
    </header>
    @if (IsCollapsed)
    {
        <div class="planner-ideas__collapsed-label" aria-hidden="true">FootSteps</div>
    }
    @if (!IsCollapsed)
    {
        <div class="planner-ideas__body" aria-live="polite">
            @if (EffectiveState == PlannerIdeasState.NoSelection)
            {
                <PlannerWorkspaceState Kind="PlannerWorkspaceStateKind.Empty" Title="Choose a destination or day" Message="Select context on the itinerary board to explore related suggestions." />
            }
            else if (EffectiveState == PlannerIdeasState.Loading)
            {
                <PlannerWorkspaceState Kind="PlannerWorkspaceStateKind.Loading" Title="Finding FootSteps…" />
            }
            else if (EffectiveState == PlannerIdeasState.Denied)
            {
                <PlannerWorkspaceState Kind="PlannerWorkspaceStateKind.Denied" Title="FootSteps unavailable" Message="This context is not available to your workspace." />
            }
            else if (EffectiveState == PlannerIdeasState.Unavailable)
            {
                <PlannerWorkspaceState Kind="PlannerWorkspaceStateKind.Unavailable" Title="FootSteps temporarily unavailable" Message="Manual planning remains available." />
            }
            else if (EffectiveState == PlannerIdeasState.Empty)
            {
                <PlannerWorkspaceState Kind="PlannerWorkspaceStateKind.Empty" Title="No FootSteps for this context" Message="Your plan is unchanged. Try another destination or day." />
            }
            else
            {
                <div class="planner-ideas__context">
                    <p>FootSteps for <strong>@Context!.Label</strong></p>
                    @if (Context.Kind != PlannerIdeasContextKind.Adventure)
                    {
                        <button type="button" @onclick="ShowWholeAdventureAsync">Whole Adventure</button>
                    }
                </div>
                @if (Context.Kind == PlannerIdeasContextKind.Adventure)
                {
                    <PlannerJourneyExplorationFocus OnSelectionChanged="ChangeExplorationAreasAsync" />
                }
                @if (ApplicationStatusMessage is not null)
                {
                    <p class="planner-ideas__application-status" role="status">@ApplicationStatusMessage</p>
                }
                <nav class="planner-ideas__types" aria-label="FootStep types for @Context.Label">
                    <button type="button" aria-pressed="@(SelectedType is null ? "true" : "false")" @onclick="() => SelectType(null)">All</button>
                    @foreach (var type in AvailableTypes)
                    {
                        <button type="button" aria-pressed="@(SelectedType == type ? "true" : "false")" @onclick="() => SelectType(type)">@DisplayFacet(type)</button>
                    }
                </nav>
                <details class="planner-ideas__filters">
                    <summary>Filter (@FacetedIdeas.Count)</summary>
                    <fieldset>
                        <legend>Travel details</legend>
                        <label>Minimum days <input type="number" min="1" max="365" value="@MinimumDays" @onchange="ChangeMinimumDays" /></label>
                        <label>Maximum days <input type="number" min="1" max="365" value="@MaximumDays" @onchange="ChangeMaximumDays" /></label>
                        @foreach (var facet in AvailableFacets)
                        {
                            <label><input type="checkbox" checked="@SelectedFacets.Contains(facet.Key)" @onchange="() => ToggleFacet(facet)" /> @DisplayFacet(facet.Value) <span>(@facet.Group)</span></label>
                        }
                    </fieldset>
                    @if (SelectedType is not null || SelectedFacets.Count > 0 || MinimumDays.HasValue || MaximumDays.HasValue)
                    {
                        <div class="planner-ideas__chips" aria-label="Active FootStep filters">
                            @if (SelectedType is not null) { <button type="button" @onclick="() => SelectType(null)">@DisplayFacet(SelectedType) ×</button> }
                            @foreach (var key in SelectedFacets) { var facet = PlannerFacetOption.Parse(key); <button type="button" @onclick="() => ToggleFacet(facet)">@DisplayFacet(facet.Value) ×</button> }
                            <button type="button" @onclick="ClearFilters">Clear all</button>
                        </div>
                    }
                </details>
                <div class="planner-ideas__display-controls">
                    <label>Group by
                        <select value="@GroupBy" @onchange="ChangeGrouping">
                            <option value="None">No grouping</option><option value="Kind">FootStep type</option>
                            <option value="Transportation">Transportation</option><option value="Category">Category</option><option value="Source">Source</option>
                        </select>
                    </label>
                    <label>Sort by
                        <select value="@SortBy" @onchange="ChangeSort">
                            <option value="Catalog">Catalog order</option><option value="Title">Title</option>
                            <option value="ShortestDuration">Shortest duration</option><option value="LongestDuration">Longest duration</option><option value="Source">Source</option>
                        </select>
                    </label>
                    <div class="planner-ideas__view-toggle" role="group" aria-label="FootStep view type">
                        <button type="button" class="planner-ideas__view-button" aria-label="Card view" title="Card view" aria-pressed="@(ViewType == PlannerFootStepView.Cards)" @onclick="() => ChangeView(PlannerFootStepView.Cards)">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                        </button>
                        <button type="button" class="planner-ideas__view-button" aria-label="List view" title="List view" aria-pressed="@(ViewType == PlannerFootStepView.List)" @onclick="() => ChangeView(PlannerFootStepView.List)">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="5" cy="6" r="1.5"/><path d="M9 6h12M9 12h12M9 18h12"/><circle cx="5" cy="12" r="1.5"/><circle cx="5" cy="18" r="1.5"/></svg>
                        </button>
                        <button type="button" class="planner-ideas__view-button" aria-label="Tabular view" title="Tabular view" aria-pressed="@(ViewType == PlannerFootStepView.Tabular)" @onclick="() => ChangeView(PlannerFootStepView.Tabular)">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="16" rx="1"/><path d="M3 9h18M3 14h18M9 4v16M15 4v16"/></svg>
                        </button>
                    </div>
                </div>
                @if (FacetedIdeas.Count == 0)
                {
                    <PlannerWorkspaceState Kind="PlannerWorkspaceStateKind.Empty" Title="No FootSteps match this exploration" Message="@EmptyMatchMessage" />
                }
                @foreach (var group in PagedGroups)
                {
                    @if (group.Label is not null) { <h4 class="planner-ideas__group-heading">@group.Label</h4> }
                    @if (ViewType == PlannerFootStepView.Tabular)
                    {
                        <div class="planner-ideas__table-region" tabindex="0" role="region" aria-label="FootSteps table">
                            <table class="planner-ideas__table">
                                <caption>FootSteps for @Context.Label</caption>
                                <thead><tr><th scope="col">FootStep</th><th scope="col">Type</th><th scope="col">Location</th><th scope="col">Transportation</th><th scope="col">Duration</th><th scope="col">Category</th><th scope="col">Source</th><th scope="col">Action</th></tr></thead>
                                <tbody>
                                @foreach (var idea in group.Items)
                                {
                                    <tr draggable="@DraggableValue(idea)" data-planner-footstep-kind="@DragKind(idea)" data-planner-footstep-id="@idea.Id">
                                        <th scope="row"><span>@idea.Title</span><small>@idea.Summary</small></th>
                                        <td>@DisplayFacet(idea.Kind)</td>
                                        <td>@DisplayValues(idea.Places)</td>
                                        <td>@DisplayValues(idea.TransportationModes)</td>
                                        <td>@DisplayDuration(idea.DurationDays)</td>
                                        <td>@DisplayValues(idea.Categories)</td>
                                        <td>@idea.Attribution</td>
                                        <td>
                                            @if (CanEdit && idea.DestinationDraft is { } destination && !string.IsNullOrWhiteSpace(ApplyDestinationPath))
                                            {
                                                <details class="planner-ideas__apply"><summary>Preview destination</summary>
                                                    <p>Add <strong>@destination.Name</strong> as a proposed destination. Nothing is booked.</p>
                                                    <form method="post" action="@ApplyDestinationPath">
                                                        <AntiforgeryToken />
                                                        <input type="hidden" name="idempotencyKey" value="@ApplicationKey(idea)" />
                                                        <input type="hidden" name="expectedVersion" value="@ExpectedVersion" />
                                                        <input type="hidden" name="footStepId" value="@idea.Id" />
                                                        <input type="hidden" name="footStepVersion" value="@idea.Version" />
                                                        <input type="hidden" name="timeZoneId" value="@destination.TimeZoneId" />
                                                        <label>Start date <input type="date" name="startDate" value="@PlanStartDate.ToString("yyyy-MM-dd")" min="@PlanStartDate.ToString("yyyy-MM-dd")" max="@PlanEndDate.ToString("yyyy-MM-dd")" required /></label>
                                                        <label>End date <input type="date" name="endDate" value="@SuggestedEnd(idea).ToString("yyyy-MM-dd")" min="@PlanStartDate.ToString("yyyy-MM-dd")" max="@PlanEndDate.ToString("yyyy-MM-dd")" required /></label>
                                                        <button type="submit">Add destination to Journey</button>
                                                    </form>
                                                </details>
                                            }
                                            <PlannerActivityFootStepReview FootStep="@idea"
                                                                                          Targets="@ActivityTargets"
                                                                                          CanEdit="@CanEdit"
                                                                                          ExpectedVersion="@ExpectedVersion"
                                                                                          AddActivityPath="@AddActivityPath" />
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <ul class="planner-ideas__list">
                        @foreach (var idea in group.Items)
                        {
                            <li><article class="planner-ideas__card" draggable="@DraggableValue(idea)" data-planner-footstep-kind="@DragKind(idea)" data-planner-footstep-id="@idea.Id">
                                <div class="planner-ideas__thumbnail" aria-hidden="true">@Monogram(idea)</div>
                                <p class="planner-ideas__type">@DisplayFacet(idea.Kind) · suggestion</p>
                                <h4>@idea.Title</h4>
                                <p>@idea.Summary</p>
                                <dl><div><dt>Source</dt><dd>@idea.Attribution</dd></div><div><dt>Freshness</dt><dd>@idea.Freshness</dd></div><div><dt>Why</dt><dd>@WhyThisFootStep(idea)</dd></div></dl>
                                <p class="planner-ideas__boundary">Inspiration only — not booked, available, or added to your plan.</p>
                                @if (CanDrag(idea))
                                {
                                    <p class="planner-ideas__drag-hint">@(idea.ActivityDraft is not null ? "Drag to an itinerary day, or review it below." : "Drag to Destinations and route, or preview it below.")</p>
                                }
                                @if (CanEdit && idea.DestinationDraft is { } destination && !string.IsNullOrWhiteSpace(ApplyDestinationPath))
                                {
                                    <details class="planner-ideas__apply"><summary>Preview destination</summary>
                                        <p>Add <strong>@destination.Name</strong> as a proposed destination using <strong>@destination.TimeZoneId</strong>. Review the inclusive dates before confirming. Nothing is booked.</p>
                                        <form method="post" action="@ApplyDestinationPath">
                                            <AntiforgeryToken />
                                            <input type="hidden" name="idempotencyKey" value="@ApplicationKey(idea)" />
                                            <input type="hidden" name="expectedVersion" value="@ExpectedVersion" />
                                            <input type="hidden" name="footStepId" value="@idea.Id" />
                                            <input type="hidden" name="footStepVersion" value="@idea.Version" />
                                            <input type="hidden" name="timeZoneId" value="@destination.TimeZoneId" />
                                            <label>Start date <input type="date" name="startDate" value="@PlanStartDate.ToString("yyyy-MM-dd")" min="@PlanStartDate.ToString("yyyy-MM-dd")" max="@PlanEndDate.ToString("yyyy-MM-dd")" required /></label>
                                            <label>End date <input type="date" name="endDate" value="@SuggestedEnd(idea).ToString("yyyy-MM-dd")" min="@PlanStartDate.ToString("yyyy-MM-dd")" max="@PlanEndDate.ToString("yyyy-MM-dd")" required /></label>
                                            <button type="submit">Add destination to Journey</button>
                                        </form>
                                    </details>
                                }
                                <PlannerActivityFootStepReview FootStep="@idea"
                                                                                      Targets="@ActivityTargets"
                                                                                      CanEdit="@CanEdit"
                                                                                      ExpectedVersion="@ExpectedVersion"
                                                                                      AddActivityPath="@AddActivityPath" />
                            </article></li>
                        }
                        </ul>
                    }
                }
                <PlannerIdeaPager TotalItems="@FacetedIdeas.Count"
                                  PageSize="@PageSize"
                                  CurrentPage="@CurrentPage"
                                  PageSizeOptions="@RailPageSizeOptions"
                                  OnPageSizeChanged="ChangePageSizeAsync"
                                  OnPageChanged="ChangePageAsync" />
            }
        </div>
        <div class="planner-ideas__width-controls" role="group" aria-label="FootSteps rail width">
            <button type="button"
                    aria-label="Narrow FootSteps rail"
                    title="Narrow FootSteps rail"
                    disabled="@(WidthPixels <= MinimumWidthPixels)"
                    @onclick="NarrowRailAsync">−</button>
            <span aria-hidden="true">Width</span>
            <button type="button"
                    aria-label="Widen FootSteps rail"
                    title="Widen FootSteps rail"
                    disabled="@(WidthPixels >= MaximumWidthPixels)"
                    @onclick="WidenRailAsync">+</button>
        </div>
        <div class="planner-ideas__resize" role="separator" aria-label="Resize FootSteps rail" aria-orientation="vertical" tabindex="0" aria-valuemin="@MinimumWidthPixels" aria-valuemax="@MaximumWidthPixels" aria-valuenow="@WidthPixels" @onkeydown="HandleResizeKeyAsync" @onpointerdown="BeginPointerResizeAsync" @onpointermove="ContinuePointerResizeAsync" @onpointerup="EndPointerResize" @onpointercancel="EndPointerResize"></div>
    }
</aside>
@if (IsDrawerOpen)
{
    <button type="button" class="planner-ideas__backdrop" aria-label="Close FootSteps" @onclick="CloseDrawerAsync"></button>
}
