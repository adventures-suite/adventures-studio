@namespace TheSimontonAdventures.Web.Components

@if (TotalItems > 0)
{
    <div class="idea-pager" aria-label="Idea pages">
        <label>
            Cards per page
            <select value="@PageSize" @onchange="ChangePageSizeAsync">
                @foreach (var option in PageSizeOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </label>
        <p aria-live="polite">Page @EffectivePage of @TotalPages · @TotalItems @(TotalItems == 1 ? "idea" : "ideas")</p>
        <div>
            <button type="button" disabled="@(EffectivePage <= 1)" @onclick="PreviousPageAsync">Previous</button>
            <button type="button" disabled="@(EffectivePage >= TotalPages)" @onclick="NextPageAsync">Next</button>
        </div>
    </div>
}
