@namespace TheSimontonAdventures.Web.Components

<section class="planner-board" aria-labelledby="planner-board-heading">
    <header class="planner-board__header">
        <div>
            <p class="planner-board__eyebrow">Itinerary board</p>
            <h3 id="planner-board-heading">Plan the journey</h3>
        </div>
        <p>Authorized plan details only. Proposed items are not bookings or confirmations.</p>
    </header>

    <section class="planner-board__card planner-board__route" aria-labelledby="plan-route">
        <h4 id="plan-route">Destinations and route</h4>
        @Status(DestinationStatusMessage)
        @if (Plan.Destinations.Count == 0)
        {
            <p class="planner-board__empty">No destinations have been added.</p>
        }
        else
        {
            <ol class="planner-board__route-list">
                @foreach (var destination in Plan.Destinations.OrderBy(item => item.Sequence))
                {
                    <li>
                        <span class="planner-board__sequence" aria-hidden="true">@destination.Sequence</span>
                        <div><strong>@destination.Name</strong><span><time datetime="@DateValue(destination.Dates.Start)">@FormatDate(destination.Dates.Start)</time>–<time datetime="@DateValue(destination.Dates.End)">@FormatDate(destination.Dates.End)</time> · @destination.TimeZone</span></div>
                    </li>
                }
            </ol>
        }
        @if (CanEdit)
        {
            <details class="planner-board__disclosure planner-board__action" name="planner-board-action">
                <summary>Add destination</summary>
                <form class="planner-board__form" method="post" action="@AddDestinationPath">
                    <AntiforgeryToken /><input type="hidden" name="expectedVersion" value="@Plan.Version" />
                    <label for="add-destination-name">Destination name</label><input id="add-destination-name" name="name" required maxlength="200" autocomplete="off" />
                    <div class="planner-board__form-columns">
                        <div><label for="add-destination-start-date">Arrival date</label><input id="add-destination-start-date" type="date" name="startDate" min="@DateValue(Plan.Dates.Start)" max="@DateValue(Plan.Dates.End)" required /></div>
                        <div><label for="add-destination-end-date">Departure date</label><input id="add-destination-end-date" type="date" name="endDate" min="@DateValue(Plan.Dates.Start)" max="@DateValue(Plan.Dates.End)" required /></div>
                    </div>
                    <label for="add-destination-time-zone">Destination time zone</label><input id="add-destination-time-zone" name="timeZoneId" required maxlength="100" placeholder="Europe/Rome" autocomplete="off" />
                    <button type="submit">Add destination</button>
                </form>
            </details>
        }
    </section>

    <section class="planner-board__card planner-board__days" aria-labelledby="plan-itinerary">
        <h4 id="plan-itinerary">Daily itinerary</h4>
        @Status(DayEditStatusMessage)
        @Status(ActivityEditStatusMessage)
        @Status(ActivityStatusMessage)
        @Status(DayStatusMessage)
        @if (Plan.Days.Count == 0)
        {
            <p class="planner-board__empty">No itinerary days have been added.</p>
        }
        else
        {
            <ol class="planner-board__day-list">
                @foreach (var day in Plan.Days)
                {
                    <li><article class="planner-board__day">
                        <header><p><time datetime="@DateValue(day.Date)">@day.Date.ToString("ddd, MMM d, yyyy")</time> · @day.TimeZone</p><h5>@day.Title</h5>@if (DestinationName(day) is { } destinationName){<span>@destinationName</span>}</header>
                        @if (CanEdit)
                        {
                            <details class="planner-board__disclosure planner-board__day-editor" name="planner-board-action">
                                <summary>Edit itinerary day: @day.Title</summary>
                                <form class="planner-board__form" method="post" action="@EditDayPath(day.Id)">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="expectedVersion" value="@Plan.Version" />
                                    <label for="@DayFieldId(day.Id, "title")">Day title for @day.Date.ToString("MMM d")</label><input id="@DayFieldId(day.Id, "title")" name="title" value="@day.Title" required maxlength="200" autocomplete="off" />
                                    <div class="planner-board__form-actions"><button type="submit">Save itinerary day</button><a class="planner-board__secondary-button" href="@DayCancelPath">Cancel</a></div>
                                </form>
                            </details>
                        }
                        @if (day.Activities.Count == 0)
                        {
                            <p class="planner-board__empty">No activities have been added.</p>
                        }
                        else
                        {
                            <ol class="planner-board__activity-list">
                                @foreach (var activity in day.Activities)
                                {
                                    <li>
                                        <span>@FormatTimeRange(activity.StartsAtLocal, activity.EndsAtLocal)</span><strong>@activity.Title</strong><small>@FormatStatus(activity.Status)</small>
                                        @if (CanEdit)
                                        {
                                            <details class="planner-board__disclosure planner-board__activity-editor" name="planner-board-action">
                                                <summary>Edit activity: @activity.Title</summary>
                                                <form class="planner-board__form" method="post" action="@EditActivityPath(activity.Id)">
                                                    <AntiforgeryToken />
                                                    <input type="hidden" name="expectedVersion" value="@Plan.Version" />
                                                    <label for="@ActivityFieldId(activity.Id, "title")">Activity title for @activity.Title</label><input id="@ActivityFieldId(activity.Id, "title")" name="title" value="@activity.Title" required maxlength="200" autocomplete="off" />
                                                    <div class="planner-board__form-columns">
                                                        <div><label for="@ActivityFieldId(activity.Id, "start-time")">Start time for @activity.Title <span>(optional)</span></label><input id="@ActivityFieldId(activity.Id, "start-time")" type="time" name="startsAtLocal" value="@TimeValue(activity.StartsAtLocal)" /></div>
                                                        <div><label for="@ActivityFieldId(activity.Id, "end-time")">End time for @activity.Title <span>(optional)</span></label><input id="@ActivityFieldId(activity.Id, "end-time")" type="time" name="endsAtLocal" value="@TimeValue(activity.EndsAtLocal)" /></div>
                                                    </div>
                                                    <div class="planner-board__form-actions"><button type="submit">Save activity</button><a class="planner-board__secondary-button" href="@ActivityCancelPath">Cancel</a></div>
                                                </form>
                                            </details>
                                        }
                                    </li>
                                }
                            </ol>
                        }
                        @if (CanEdit)
                        {
                            <details class="planner-board__disclosure planner-board__action" name="planner-board-action">
                                <summary>Add activity to @day.Title</summary>
                                <form class="planner-board__form" method="post" action="@AddActivityPath">
                                    <AntiforgeryToken /><input type="hidden" name="expectedVersion" value="@Plan.Version" /><input type="hidden" name="itineraryDayId" value="@day.Id.Value" />
                                    <label for="@DayFieldId(day.Id, "new-activity-title")">Proposed activity for @day.Title</label><input id="@DayFieldId(day.Id, "new-activity-title")" name="title" required maxlength="200" autocomplete="off" placeholder="Museum visit" />
                                    <div class="planner-board__form-columns"><div><label for="@DayFieldId(day.Id, "new-activity-start-time")">Start time for new activity on @day.Title <span>(optional)</span></label><input id="@DayFieldId(day.Id, "new-activity-start-time")" type="time" name="startsAtLocal" /></div><div><label for="@DayFieldId(day.Id, "new-activity-end-time")">End time for new activity on @day.Title <span>(optional)</span></label><input id="@DayFieldId(day.Id, "new-activity-end-time")" type="time" name="endsAtLocal" /></div></div>
                                    <button type="submit">Add proposed activity</button>
                                </form>
                            </details>
                        }
                    </article></li>
                }
            </ol>
        }
        @if (CanEdit && Plan.Destinations.Count > 0)
        {
            <details class="planner-board__disclosure planner-board__action" name="planner-board-action">
                <summary>Add itinerary day</summary>
                <form class="planner-board__form" method="post" action="@AddDayPath">
                    <AntiforgeryToken /><input type="hidden" name="expectedVersion" value="@Plan.Version" />
                    <label for="add-day-destination">Destination visit</label><select id="add-day-destination" name="destinationVisitId" required>@foreach (var destination in Plan.Destinations.OrderBy(item => item.Sequence)){<option value="@destination.Id.Value">@destination.Name · @FormatDates(destination.Dates)</option>}</select>
                    <label for="add-day-date">Local date</label><input id="add-day-date" type="date" name="date" min="@DateValue(Plan.Dates.Start)" max="@DateValue(Plan.Dates.End)" required />
                    <label for="add-day-title">Day title</label><input id="add-day-title" name="title" required maxlength="200" autocomplete="off" placeholder="Arrival in Rome" />
                    <button type="submit">Add itinerary day</button>
                </form>
            </details>
        }
        else if (CanEdit)
        {
            <p class="planner-board__boundary">Add a destination before adding an itinerary day.</p>
        }
    </section>

    <section class="planner-board__card" aria-labelledby="plan-transportation">
        <h4 id="plan-transportation">Transportation</h4>
        @Status(TransportationEditStatusMessage)
        @Status(TransportationStatusMessage)
        @if (Plan.Transportation.Count == 0)
        {
            <p class="planner-board__empty">No transportation has been added.</p>
        }
        else
        {
            <ul class="planner-board__summary-list">
                @foreach (var segment in Plan.Transportation)
                {
                    <li>
                        <strong>@segment.Mode: @segment.From to @segment.To</strong>
                        <span><time datetime="@DateValue(segment.DepartureDate)">@FormatDate(segment.DepartureDate)</time>@FormatOptionalTime(segment.DepartureTimeLocal) · @segment.DepartureTimeZone</span>
                        <span>Arrives <time datetime="@DateValue(segment.ArrivalDate)">@FormatDate(segment.ArrivalDate)</time>@FormatOptionalTime(segment.ArrivalTimeLocal) · @segment.ArrivalTimeZone</span>
                        <small>@FormatStatus(segment.Status)</small>
                        @if (CanEdit)
                        {
                            <details class="planner-board__disclosure planner-board__transportation-editor" name="planner-board-action">
                                <summary>Edit transportation: @segment.Mode from @segment.From to @segment.To</summary>
                                <form class="planner-board__form" method="post" action="@EditTransportationPath(segment.Id)">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="expectedVersion" value="@Plan.Version" />
                                    <label for="@TransportationFieldId(segment.Id, "mode")">Mode for @segment.From to @segment.To</label><input id="@TransportationFieldId(segment.Id, "mode")" name="mode" value="@segment.Mode" required maxlength="100" autocomplete="off" />
                                    <label for="@TransportationFieldId(segment.Id, "from")">Origin for @segment.Mode transportation</label><input id="@TransportationFieldId(segment.Id, "from")" name="from" value="@segment.From" required maxlength="200" autocomplete="off" />
                                    <label for="@TransportationFieldId(segment.Id, "to")">Destination for @segment.Mode transportation</label><input id="@TransportationFieldId(segment.Id, "to")" name="to" value="@segment.To" required maxlength="200" autocomplete="off" />
                                    <div class="planner-board__form-columns">
                                        <div><label for="@TransportationFieldId(segment.Id, "departure-date")">Departure date for @segment.Mode from @segment.From</label><input id="@TransportationFieldId(segment.Id, "departure-date")" type="date" name="departureDate" value="@DateValue(segment.DepartureDate)" min="@DateValue(Plan.Dates.Start)" max="@DateValue(Plan.Dates.End)" required /></div>
                                        <div><label for="@TransportationFieldId(segment.Id, "departure-time")">Departure time for @segment.Mode from @segment.From <span>(optional)</span></label><input id="@TransportationFieldId(segment.Id, "departure-time")" type="time" name="departureTimeLocal" value="@TimeValue(segment.DepartureTimeLocal)" /></div>
                                    </div>
                                    <label for="@TransportationFieldId(segment.Id, "departure-time-zone")">Departure time zone for @segment.Mode from @segment.From</label><input id="@TransportationFieldId(segment.Id, "departure-time-zone")" name="departureTimeZoneId" value="@segment.DepartureTimeZone.Value" required maxlength="100" autocomplete="off" />
                                    <div class="planner-board__form-columns">
                                        <div><label for="@TransportationFieldId(segment.Id, "arrival-date")">Arrival date for @segment.Mode to @segment.To</label><input id="@TransportationFieldId(segment.Id, "arrival-date")" type="date" name="arrivalDate" value="@DateValue(segment.ArrivalDate)" min="@DateValue(Plan.Dates.Start)" max="@DateValue(Plan.Dates.End)" required /></div>
                                        <div><label for="@TransportationFieldId(segment.Id, "arrival-time")">Arrival time for @segment.Mode to @segment.To <span>(optional)</span></label><input id="@TransportationFieldId(segment.Id, "arrival-time")" type="time" name="arrivalTimeLocal" value="@TimeValue(segment.ArrivalTimeLocal)" /></div>
                                    </div>
                                    <label for="@TransportationFieldId(segment.Id, "arrival-time-zone")">Arrival time zone for @segment.Mode to @segment.To</label><input id="@TransportationFieldId(segment.Id, "arrival-time-zone")" name="arrivalTimeZoneId" value="@segment.ArrivalTimeZone.Value" required maxlength="100" autocomplete="off" />
                                    <div class="planner-board__form-actions"><button type="submit">Save transportation</button><a class="planner-board__secondary-button" href="@TransportationCancelPath">Cancel</a></div>
                                </form>
                            </details>
                        }
                    </li>
                }
            </ul>
        }
        @if (CanEdit)
        {
            <details class="planner-board__disclosure planner-board__action" name="planner-board-action">
                <summary>Add transportation</summary>
                <form class="planner-board__form" method="post" action="@AddTransportationPath"><AntiforgeryToken /><input type="hidden" name="expectedVersion" value="@Plan.Version" /><label for="add-transportation-mode">Mode</label><input id="add-transportation-mode" name="mode" required maxlength="100" placeholder="Flight, rail, cruise, or car" /><label for="add-transportation-from">From</label><input id="add-transportation-from" name="from" required maxlength="200" /><label for="add-transportation-to">To</label><input id="add-transportation-to" name="to" required maxlength="200" /><div class="planner-board__form-columns"><div><label for="add-transportation-departure-date">Departure date</label><input id="add-transportation-departure-date" type="date" name="departureDate" required /></div><div><label for="add-transportation-departure-time">Departure time <span>(optional)</span></label><input id="add-transportation-departure-time" type="time" name="departureTimeLocal" /></div></div><label for="add-transportation-departure-time-zone">Departure time zone</label><input id="add-transportation-departure-time-zone" name="departureTimeZoneId" required maxlength="100" placeholder="America/Phoenix" /><div class="planner-board__form-columns"><div><label for="add-transportation-arrival-date">Arrival date</label><input id="add-transportation-arrival-date" type="date" name="arrivalDate" required /></div><div><label for="add-transportation-arrival-time">Arrival time <span>(optional)</span></label><input id="add-transportation-arrival-time" type="time" name="arrivalTimeLocal" /></div></div><label for="add-transportation-arrival-time-zone">Arrival time zone</label><input id="add-transportation-arrival-time-zone" name="arrivalTimeZoneId" required maxlength="100" placeholder="Europe/Rome" /><button type="submit">Add proposed transportation</button></form>
            </details>
        }
    </section>

    <section class="planner-board__card" aria-labelledby="plan-accommodations">
        <h4 id="plan-accommodations">Accommodations</h4>
        @Status(AccommodationEditStatusMessage)
        @Status(AccommodationStatusMessage)
        @if (Plan.Accommodations.Count == 0)
        {
            <p class="planner-board__empty">No accommodations have been added.</p>
        }
        else
        {
            <ul class="planner-board__summary-list">
                @foreach (var accommodation in Plan.Accommodations)
                {
                    <li>
                        <strong>@accommodation.Name</strong>
                        <span>Start date <time datetime="@DateValue(accommodation.Dates.Start)">@FormatDate(accommodation.Dates.Start)</time> · End date <time datetime="@DateValue(accommodation.Dates.End)">@FormatDate(accommodation.Dates.End)</time> · @accommodation.TimeZone</span>
                        <small>@FormatStatus(accommodation.Status)</small>
                        @if (CanEdit)
                        {
                            <details class="planner-board__disclosure planner-board__accommodation-editor" name="planner-board-action">
                                <summary>Edit accommodation: @accommodation.Name</summary>
                                <form class="planner-board__form" method="post" action="@EditAccommodationPath(accommodation.Id)">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="expectedVersion" value="@Plan.Version" />
                                    <label for="@AccommodationFieldId(accommodation.Id, "name")">Accommodation name for @accommodation.Name</label><input id="@AccommodationFieldId(accommodation.Id, "name")" name="name" value="@accommodation.Name" required maxlength="200" autocomplete="off" />
                                    <div class="planner-board__form-columns">
                                        <div><label for="@AccommodationFieldId(accommodation.Id, "start-date")">Start date for @accommodation.Name</label><input id="@AccommodationFieldId(accommodation.Id, "start-date")" type="date" name="startDate" value="@DateValue(accommodation.Dates.Start)" min="@DateValue(Plan.Dates.Start)" max="@DateValue(Plan.Dates.End)" required /></div>
                                        <div><label for="@AccommodationFieldId(accommodation.Id, "end-date")">End date for @accommodation.Name</label><input id="@AccommodationFieldId(accommodation.Id, "end-date")" type="date" name="endDate" value="@DateValue(accommodation.Dates.End)" min="@DateValue(Plan.Dates.Start)" max="@DateValue(Plan.Dates.End)" required /></div>
                                    </div>
                                    <label for="@AccommodationFieldId(accommodation.Id, "time-zone")">Property time zone for @accommodation.Name</label><input id="@AccommodationFieldId(accommodation.Id, "time-zone")" name="timeZoneId" value="@accommodation.TimeZone.Value" required maxlength="100" autocomplete="off" />
                                    <div class="planner-board__form-actions"><button type="submit">Save accommodation</button><a class="planner-board__secondary-button" href="@AccommodationCancelPath">Cancel</a></div>
                                </form>
                            </details>
                        }
                    </li>
                }
            </ul>
        }
        @if (CanEdit)
        {
            <details class="planner-board__disclosure planner-board__action" name="planner-board-action">
                <summary>Add accommodation</summary>
                <form class="planner-board__form" method="post" action="@AddAccommodationPath"><AntiforgeryToken /><input type="hidden" name="expectedVersion" value="@Plan.Version" /><label for="add-accommodation-name">Accommodation name</label><input id="add-accommodation-name" name="name" required maxlength="200" /><div class="planner-board__form-columns"><div><label for="add-accommodation-start-date">Start date</label><input id="add-accommodation-start-date" type="date" name="startDate" required /></div><div><label for="add-accommodation-end-date">End date</label><input id="add-accommodation-end-date" type="date" name="endDate" required /></div></div><label for="add-accommodation-time-zone">Property time zone</label><input id="add-accommodation-time-zone" name="timeZoneId" required maxlength="100" placeholder="Europe/Rome" /><button type="submit">Add proposed accommodation</button></form>
            </details>
        }
    </section>

    <section class="planner-board__card planner-board__reservations" aria-labelledby="plan-reservations">
        <h4 id="plan-reservations">Reservation summaries</h4><p class="planner-board__boundary">Credential-free planning summaries only. A summary does not prove a booking or confirmation.</p>@Status(ReservationStatusMessage)
        @if (Plan.Reservations.Count == 0){<p class="planner-board__empty">No reservation summaries have been added.</p>}else{<ul class="planner-board__summary-list">@foreach(var reservation in Plan.Reservations){<li><strong>@reservation.Subject</strong><small>@FormatStatus(reservation.Status)</small></li>}</ul>}
        @if (CanEdit)
        {
            <details class="planner-board__disclosure planner-board__action" name="planner-board-action">
                <summary>Add reservation summary</summary>
                <form class="planner-board__form" method="post" action="@AddReservationPath"><AntiforgeryToken /><input type="hidden" name="expectedVersion" value="@Plan.Version" /><label for="add-reservation-subject">Reservation subject</label><input id="add-reservation-subject" name="subject" required maxlength="200" autocomplete="off" placeholder="Hotel, tour, or transportation hold" /><p>Confirmation references are added through a separate protected workflow.</p><button type="submit">Add proposed reservation</button></form>
            </details>
        }
    </section>
</section>
