@inject ICreatorContextAccessor CreatorContextAccessor
@using TheSimontonAdventures.Web.Components.Platform
@inject IResourceService ResourceService
@inject IHttpContextAccessor HttpContextAccessor
@inject ITrustedRequestHostContextAccessor TrustedRequestHostContextAccessor
@inject AuthenticationConfiguration AuthenticationConfiguration
@inject Microsoft.Extensions.Options.IOptions<PlatformHostOptions> PlatformHostConfiguration
@inject IConfiguration Configuration

<!DOCTYPE html>
<html lang="@Locale">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["TheSimontonAdventures.Web.styles.css"]" />
    <ImportMap AdditionalAttributes="@ImportMapAttributes" />
    <meta name="description" content="@Description" />
    @if (Configuration.GetValue<bool>("Preview:NoIndex"))
    {
        <meta name="robots" content="noindex,nofollow,noarchive" />
    }
    @if (!string.IsNullOrEmpty(FaviconUrl))
    {
        <link rel="icon" href="@FaviconUrl" />
    }
    <HeadOutlet />
</head>

<body>
    @if (HostType == TrustedRequestHostType.PlatformWorkspace)
    {
        <WorkspaceRoot />
    }
    else if (HostType == TrustedRequestHostType.PublicPlatform)
    {
        <PlatformLanding SignInUrl="@SignInUrl" FeaturedAdventureUrl="@FeaturedAdventureUrl" />
    }
    else
    {
        <Routes />
    }
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private const string WorkspaceDescription =
        "Private AdventuresSuite workspace.";

    private string Description { get; set; } = WorkspaceDescription;
    private string FaviconUrl { get; set; } = string.Empty;
    private IReadOnlyDictionary<string, object>? ImportMapAttributes { get; set; }
    private TrustedRequestHostType HostType { get; set; }
    private string SignInUrl { get; set; } = "#returning-creators";
    private string FeaturedAdventureUrl { get; set; } = string.Empty;
    private string Locale { get; set; } = "en-US";

    protected override async Task OnInitializedAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext
            ?? throw new InvalidOperationException("Server rendering requires an HTTP context.");
        ImportMapAttributes = new Dictionary<string, object>
        {
            ["nonce"] = BrowserSecurityHeadersMiddleware.GetNonce(httpContext)
        };

        HostType = TrustedRequestHostContextAccessor.Current.Type;
        if (HostType == TrustedRequestHostType.PlatformWorkspace)
        {
            return;
        }

        if (HostType == TrustedRequestHostType.PublicPlatform)
        {
            FeaturedAdventureUrl = PlatformHostConfiguration.Value.FeaturedAdventureUrl;
            if (!string.IsNullOrWhiteSpace(PlatformHostConfiguration.Value.WorkspaceSignInUrl))
            {
                SignInUrl = PlatformHostConfiguration.Value.WorkspaceSignInUrl;
            }
            else if (AuthenticationConfiguration.Mode == AuthenticationMode.ExternalProvider
                && Uri.TryCreate(AuthenticationConfiguration.WorkspaceOrigin, UriKind.Absolute, out var workspace))
            {
                SignInUrl = new Uri(workspace, AdventuresSuite.Identity.ExternalId.ExternalIdBrowserEndpoints.SignInPath)
                    .AbsoluteUri;
            }

            Description = "Dream, plan, preserve, and publish meaningful adventures with AdventuresSuite.";
            return;
        }

        Locale = CreatorContextAccessor.Current.Locale;
        Description = CreatorContextAccessor.Current.GetDefaultSeoDescription();
        FaviconUrl = await ResourceService.GetPublicUrlAsync(
            CreatorContextAccessor.Current.Id,
            CreatorContextAccessor.Current.Brand.FaviconResourceId)
            ?? string.Empty;
    }
}
