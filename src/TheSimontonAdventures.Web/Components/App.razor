@inject ICreatorContextAccessor CreatorContextAccessor

<!DOCTYPE html>
<html lang="@CreatorContextAccessor.Current.Locale">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["TheSimontonAdventures.Web.styles.css"]" />
    <ImportMap />
    <meta name="description"
          content="@CreatorContextAccessor.Current.GetDefaultSeoDescription()" />
    <link rel="icon" href="@FaviconUrl" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private string FaviconUrl =>
        string.IsNullOrWhiteSpace(CreatorContextAccessor.Current.Brand.FaviconUrl)
            ? "/favicon.png"
            : CreatorContextAccessor.Current.Brand.FaviconUrl;
}
