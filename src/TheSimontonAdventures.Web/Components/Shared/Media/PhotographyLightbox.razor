@using TheSimontonAdventures.Web.Models

@if (IsOpen && Images.Count > 0)
{
    <div class="lightbox-backdrop"
         role="dialog"
         aria-modal="true"
         aria-label="Photography viewer"
         @onclick="Close">

        <div class="lightbox"
             @onclick:stopPropagation>

            <button class="lightbox-close"
                    type="button"
                    @onclick="Close"
                    aria-label="Close photography viewer">
                ✕
            </button>

            @if (Images.Count > 1)
            {
                <button class="lightbox-previous"
                        type="button"
                        @onclick="Previous"
                        aria-label="View previous image">
                    ‹
                </button>
            }

            <figure class="lightbox-figure">
                <img src="@Current.PublicUrl"
                     alt="@Current.AlternativeText" />

                <figcaption class="lightbox-caption">
                    @if (!string.IsNullOrWhiteSpace(Current.Caption))
                    {
                        <span class="lightbox-caption__text">
                            @Current.Caption
                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(Current.Attribution)
                        || !string.IsNullOrWhiteSpace(Current.Copyright))
                    {
                        <small class="lightbox-caption__credit">
                            @if (!string.IsNullOrWhiteSpace(Current.Attribution))
                            {
                                <span>Photo: @Current.Attribution</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(Current.Copyright))
                            {
                                <span>@Current.Copyright</span>
                            }
                        </small>
                    }

                    <small class="lightbox-caption__position">
                        @(CurrentIndex + 1) of @Images.Count
                    </small>
                </figcaption>
            </figure>

            @if (Images.Count > 1)
            {
                <button class="lightbox-next"
                        type="button"
                        @onclick="Next"
                        aria-label="View next image">
                    ›
                </button>
            }
        </div>
    </div>
}

@code {
    /// <summary>Gets or sets whether the modal lightbox is visible.</summary>
    [Parameter]
    public bool IsOpen { get; set; }

    /// <summary>Gets or sets the images available for lightbox navigation.</summary>
    [Parameter]
    public IReadOnlyList<GalleryImage> Images { get; set; }
        = Array.Empty<GalleryImage>();

    /// <summary>Gets or sets the zero-based index of the active image.</summary>
    [Parameter]
    public int CurrentIndex { get; set; }

    /// <summary>Gets or sets the callback invoked when the lightbox closes.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when navigation changes the active index.
    /// </summary>
    [Parameter]
    public EventCallback<int> CurrentIndexChanged { get; set; }

    private GalleryImage Current =>
        Images[NormalizeIndex(CurrentIndex)];

    private Task Close()
    {
        return OnClose.InvokeAsync();
    }

    private Task Previous()
    {
        var index = NormalizeIndex(CurrentIndex - 1);
        return CurrentIndexChanged.InvokeAsync(index);
    }

    private Task Next()
    {
        var index = NormalizeIndex(CurrentIndex + 1);
        return CurrentIndexChanged.InvokeAsync(index);
    }

    private int NormalizeIndex(int index)
    {
        if (Images.Count == 0)
        {
            return 0;
        }

        if (index < 0)
        {
            return Images.Count - 1;
        }

        if (index >= Images.Count)
        {
            return 0;
        }

        return index;
    }
}
