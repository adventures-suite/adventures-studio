@using TheSimontonAdventures.Web.Models

<section class="journey-timeline">
    <div class="journey-timeline__header">
        <span class="journey-timeline__eyebrow">
            Journey
        </span>

        <h2>Follow the adventure</h2>
    </div>

    <div class="journey-timeline__items">
        @foreach (var stop in Stops.OrderBy(s => s.DisplayOrder))
        {
            <article class="journey-stop">
                <div class="journey-stop__icon">
                    <TravelModeIcon TravelMode="@stop.TravelMode" />
                </div>

                <div class="journey-stop__content">
                    <h3>@stop.Title</h3>

                    @if (!string.IsNullOrWhiteSpace(stop.Subtitle))
                    {
                        <p class="journey-stop__subtitle">
                            @stop.Subtitle
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(stop.TravelDescription))
                    {
                        <div class="journey-stop__travel">
                            <span class="journey-stop__travel-mode">
                                @FormatTravelMode(stop.TravelMode)
                            </span>

                            <span class="journey-stop__travel-description">
                                @stop.TravelDescription
                            </span>
                        </div>
                    }
                </div>
            </article>
        }
    </div>
</section>

@code {
    [Parameter]
    public IEnumerable<JourneyStop> Stops { get; set; } =
        Enumerable.Empty<JourneyStop>();

    private static string FormatTravelMode(string travelMode)
    {
        if (string.IsNullOrWhiteSpace(travelMode))
        {
            return "Travel";
        }

        return travelMode switch
        {
            "WaterTaxi" => "Water taxi",
            _ => travelMode
        };
    }
}