@namespace TheSimontonAdventures.Web.Components

<article class="workspace-application" aria-labelledby="workspace-application-title">
    <header class="workspace-application__hero">
        <div class="workspace-application__identity">
            <span class="workspace-application__icon" aria-hidden="true">
                <WorkspaceApplicationIcon Kind="@Application.Kind" />
            </span>
            <div>
                <p class="workspace-application__eyebrow">AdventuresSuite workspace</p>
                <h2 id="workspace-application-title">@Application.Name</h2>
            </div>
        </div>
        <span class="workspace-application__status">In development</span>
        <p class="workspace-application__lead">@Application.Description</p>
        <p class="workspace-application__availability">
            @if (Application.Kind == WorkspaceApplicationKind.Dream)
            {
                <text>FootSteps are reviewed starting points, not bookings, live prices, or availability. Creating one continues through Planner review.</text>
            }
            else
            {
                <text>This preview demonstrates product direction only. It does not grant access, entitlement, availability, or permission to use unfinished capabilities.</text>
            }
        </p>
    </header>

    <section class="workspace-application__preview workspace-application__preview--@Application.Slug"
             aria-labelledby="workspace-preview-title">
        <div class="workspace-application__preview-heading">
            <p>Experience preview</p>
            <h3 id="workspace-preview-title">@Application.PreviewTitle</h3>
            <span>Representative · non-interactive</span>
        </div>
        <p class="workspace-application__preview-description">@Application.PreviewDescription</p>

        @if (Application.Kind == WorkspaceApplicationKind.Dream)
        {
            <JourneyFootStepCatalog Templates="@JourneyTemplates" PlannerPath="@PlannerPath" />
        }
        else if (Application.Kind == WorkspaceApplicationKind.Maps)
        {
            <div class="workspace-application__map" aria-label="Illustrative Journey map preview">
                <span class="workspace-application__route" aria-hidden="true"></span>
                <span class="workspace-application__pin workspace-application__pin--one" aria-hidden="true">1</span>
                <span class="workspace-application__pin workspace-application__pin--two" aria-hidden="true">2</span>
                <span class="workspace-application__pin workspace-application__pin--three" aria-hidden="true">3</span>
            </div>
        }
        else if (Application.Kind == WorkspaceApplicationKind.Companion)
        {
            <div class="workspace-application__companion-showcase">
                <figure class="workspace-application__companion-device">
                    @if (CompanionPreview is not null)
                    {
                        <img src="@CompanionPreview.PublicUrl"
                             alt="@CompanionPreview.Resource.AlternativeText" />
                    }
                    else
                    {
                        <div class="workspace-application__companion-fallback" role="img" aria-label="Companion mobile experience preview">
                            <span>AdventuresSuite</span>
                            <strong>Companion</strong>
                        </div>
                    }
                    <figcaption>Companion experience concept</figcaption>
                </figure>
                <div class="workspace-application__store-preview" aria-label="Planned mobile distribution">
                    <p>Designed to travel with you</p>
                    <strong>Planned for iPhone, iPad, and Android</strong>
                    <div class="workspace-application__store-badges">
                        <span class="workspace-application__store-badge">
                            <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                                <circle cx="16" cy="16" r="13" />
                                <path d="m11 22 5-13m5 13L16 9m-7 8h14" />
                            </svg>
                            <span><small>Planned for the</small>App Store</span>
                        </span>
                        <span class="workspace-application__store-badge">
                            <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                                <path d="M7 5v22l19-11Z" />
                                <path d="m7 5 12 11L7 27" />
                            </svg>
                            <span><small>Planned for</small>Google Play</span>
                        </span>
                    </div>
                    <small class="workspace-application__store-note">Preview only — Companion is not currently available for download.</small>
                </div>
            </div>
        }
        else if (Application.Kind == WorkspaceApplicationKind.Web)
        {
            <div class="workspace-application__story-image" aria-hidden="true">
                <span>Journey story</span>
                <strong>Across the Adriatic</strong>
            </div>
            @if (SimontonAdventuresUrl is not null)
            {
                <div class="workspace-application__public-preview">
                    <div>
                        <strong>See a published Adventure experience</strong>
                        <p>The Simonton Adventures shows how approved stories can become a visual, public Creator site.</p>
                    </div>
                    <a href="@SimontonAdventuresUrl.AbsoluteUri" target="_blank" rel="noopener noreferrer">
                        Visit The Simonton Adventures
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 17 17 7M8 7h9v9" /></svg>
                    </a>
                </div>
            }
        }

        <ul class="workspace-application__items">
            @foreach (var item in Application.PreviewItems)
            {
                <li>
                    <span class="workspace-application__item-mark" aria-hidden="true"></span>
                    <div>
                        <strong>@item.Label</strong>
                        <p>@item.Detail</p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(item.Metadata))
                    {
                        <small>@item.Metadata</small>
                    }
                </li>
            }
        </ul>
    </section>

    <footer class="workspace-application__footer">
        <a href="@PlannerPath">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 5-7 7 7 7" /></svg>
            Return to Planner
        </a>
        <p>Authentication, authorization, subscription, user-type, and time-bound entitlement checks remain required before any future capability can be used.</p>
    </footer>
</article>
