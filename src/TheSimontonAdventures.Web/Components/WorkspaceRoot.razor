@using AdventuresSuite.Identity.ExternalId
@using AdventuresSuite.Identity
@using TheSimontonAdventures.Web.Planning
@using TheSimontonAdventures.Web.Planning.Persistence
@using TheSimontonAdventures.Web.Creators

<PlannerWorkspaceShell Title="@WorkspaceTitle"
                       Description="@WorkspaceDescription"
                       IsContentEdgeAligned="@(Plan is not null)"
                       SimontonAdventuresUrl="@WorkspaceNavigation.SimontonAdventuresUrl"
                       WorkspaceBasePath="@WorkspaceBasePath"
                       ActiveApplicationSlug="@ActiveApplicationSlug">
    <ToolbarContent>
        @if (IsAuthenticated)
        {
            <form method="post" action="@ExternalIdBrowserEndpoints.SignOutPath">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@SignOutReturnPath" />
                <button class="workspace-signout" type="submit">Sign out</button>
            </form>
        }
    </ToolbarContent>
    <WorkspaceToolbarContent>
        @if (Plan is not null)
        {
            <div class="planner-context-toolbar">
                <a class="planner-context-toolbar__back" href="@PlanListPath" aria-label="Return to active plans">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 5-7 7 7 7" /></svg>
                    <span>Active plans</span>
                </a>
                <PlannerJourneyFocusToolbar Plan="@Plan"
                                            FocusedPanel="@FocusedPanel"
                                            OnFocusedPanelChanged="FocusPanelAsync" />
            </div>
        }
    </WorkspaceToolbarContent>
    <ChildContent>
    <div class="workspace-root">
    @if (IsAuthenticated)
    {
        @if (PlaceholderApplication is not null && LoadState == WorkspaceLoadState.Ready)
        {
            <WorkspaceApplicationPlaceholder Application="@PlaceholderApplication"
                                             PlannerPath="@PlanListPath"
                                             SimontonAdventuresUrl="@WorkspaceNavigation.SimontonAdventuresUrl" />
        }
        else if (LoadState == WorkspaceLoadState.Loading)
        {
            <PlannerWorkspaceState Kind="PlannerWorkspaceStateKind.Loading"
                                   Title="Loading your Adventure Plans…" />
        }
        else if (LoadState == WorkspaceLoadState.Unavailable)
        {
            <PlannerWorkspaceState Kind="PlannerWorkspaceStateKind.Unavailable"
                                   Title="Workspace unavailable"
                                   Message="Your account does not currently have access to this Planner workspace." />
        }
        else if (LoadState == WorkspaceLoadState.Failure)
        {
            <PlannerWorkspaceState Kind="PlannerWorkspaceStateKind.Failure"
                                   Title="Planner temporarily unavailable"
                                   Message="The private workspace could not be loaded. Please try again later." />
        }
        else if (LoadState == WorkspaceLoadState.Landing)
        {
            @if (AuthorizedCreatorWorkspaces.Count == 0)
            {
                <PlannerWorkspaceState Kind="PlannerWorkspaceStateKind.Empty"
                                       Title="No Planner workspaces"
                                       Message="Your account does not currently have an active Creator workspace with Planner access." />
                @if (WorkspaceActor?.UserId is { } userId)
                {
                    <PlannerSupportIdentity UserId="@userId.Value" />
                }
            }
            else
            {
                <PlannerCreatorWorkspaceChooser Workspaces="@AuthorizedCreatorWorkspaces" />
            }
        }
        else if (Plan is not null)
        {
            <article class="plan-detail">
                <div class="planner-contextual-layout" style="--planner-ideas-width: @(IdeasWidthPixels)px">
                <div class="planner-journey-canvas">
                @if (EditStatusMessage is not null)
                {
                    @if (IsEditConflict)
                    {
                        <PlannerWorkspaceState Kind="PlannerWorkspaceStateKind.Conflict"
                                               Title="Plan changed"
                                               Message="@EditStatusMessage" />
                    }
                    else
                    {
                        <p class="plan-create-status" role="status">@EditStatusMessage</p>
                    }
                }
                <section class="@OverviewPanelClasses" aria-labelledby="edit-plan-overview">
                    <PlannerPanelHeader Panel="PlannerWorkspacePanel.Overview"
                                        Title="Plan overview"
                                        Summary="@($"{FormatStatus(Plan.Status)} · {Plan.LifecycleStage} · {FormatDates(Plan.Dates)}")"
                                        HeadingId="edit-plan-overview"
                                        ContentId="plan-overview-content"
                                        IsExpanded="@IsPanelExpanded(PlannerWorkspacePanel.Overview)"
                                        IsFocused="@IsPanelFocused(PlannerWorkspacePanel.Overview)"
                                        OnToggle="TogglePanelAsync" />
                    <div id="plan-overview-content" hidden="@(!IsPanelExpanded(PlannerWorkspacePanel.Overview))">
                        <div class="plan-overview__layout">
                            <div class="plan-overview__details">
                            @if (!PlanCanEdit)
                            {
                                <div class="plan-overview__identity">
                                    <h2>@Plan.Title</h2>
                                    @if (!string.IsNullOrWhiteSpace(Plan.WorkingDescription))
                                    {
                                        <p>@Plan.WorkingDescription</p>
                                    }
                                </div>
                            }
                            <dl class="plan-overview__facts">
                                <div><dt>Status</dt><dd>@FormatStatus(Plan.Status)</dd></div>
                                <div><dt>Stage</dt><dd>@Plan.LifecycleStage</dd></div>
                                @if (!PlanCanEdit)
                                {
                                    <div><dt>Dates</dt><dd>@FormatDates(Plan.Dates)</dd></div>
                                }
                                <div><dt>Travelers</dt><dd>@Plan.TravelerCount</dd></div>
                                <div><dt>Plan version</dt><dd>@Plan.Version</dd></div>
                            </dl>
                            @if (PlanCanEdit)
                            {
                                <form method="post" action="@EditPlanPath">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="expectedVersion" value="@Plan.Version" />
                                    <label>
                                        Title
                                        <input name="title" value="@Plan.Title" required maxlength="200" autocomplete="off" />
                                    </label>
                                    <label>
                                        Description <span>(optional)</span>
                                        <textarea name="description" maxlength="2000" rows="3">@Plan.WorkingDescription</textarea>
                                    </label>
                                    <div class="plan-create-dates">
                                        <label>Start date<input type="date" name="startDate" value="@Plan.Dates.Start.ToString("yyyy-MM-dd")" required /></label>
                                        <label>End date<input type="date" name="endDate" value="@Plan.Dates.End.ToString("yyyy-MM-dd")" required /></label>
                                    </div>
                                    <button type="submit">Save overview</button>
                                </form>
                            }
                            </div>
                            <PlannerPlanHero ImageUrl="@PlannerHeroImageUrl"
                                             AltText="Passports and travel keepsakes representing the beginning of a Journey"
                                             IsPlaceholder="true" />
                        </div>
                    </div>
                </section>

                <PlannerItineraryBoard Plan="@Plan"
                                       CanEdit="@PlanCanEdit"
                                       ExpandedPanels="@ExpandedPanels"
                                       FocusedPanel="@FocusedPanel"
                                       OnPanelToggle="TogglePanelAsync"
                                       SelectedContext="@SelectedIdeasContext"
                                       OnContextSelected="SelectIdeasContextAsync"
                                       IsDestinationFootStepDragging="@(DraggedDestinationFootStep is not null)"
                                       PendingDestinationFootStep="@PendingDestinationFootStep"
                                       OnDestinationFootStepDropped="DropDestinationFootStepAsync"
                                       OnDestinationFootStepReviewCancelled="CancelDestinationFootStepReviewAsync"
                                       IsActivityFootStepDragging="@(DraggedActivityFootStep is not null)"
                                       PendingActivityFootStep="@PendingActivityFootStep"
                                       OnActivityFootStepReviewCancelled="CancelActivityFootStepReviewAsync"
                                       ApplyDestinationFootStepPath="@ApplyDestinationFootStepPath"
                                       AddDestinationPath="@AddDestinationPath"
                                       ReorderDestinationPath="@ReorderDestinationPath"
                                       AddDayPath="@AddDayPath"
                                       EditDayPathPrefix="@AddDayPath"
                                       DayCancelPath="@PlanPath(Plan.Id)"
                                       AddActivityPath="@AddActivityPath"
                                       EditActivityPathPrefix="@AddActivityPath"
                                       ActivityCancelPath="@PlanPath(Plan.Id)"
                                       AddTransportationPath="@AddTransportationPath"
                                       EditTransportationPathPrefix="@AddTransportationPath"
                                       TransportationCancelPath="@PlanPath(Plan.Id)"
                                       AddAccommodationPath="@AddAccommodationPath"
                                       EditAccommodationPathPrefix="@AddAccommodationPath"
                                       AccommodationCancelPath="@PlanPath(Plan.Id)"
                                       AddReservationPath="@AddReservationPath"
                                       DestinationStatusMessage="@DestinationStatusMessage"
                                       RouteStatusMessage="@RouteStatusMessage"
                                       DayStatusMessage="@DayStatusMessage"
                                       DayEditStatusMessage="@DayEditStatusMessage"
                                       ActivityStatusMessage="@ActivityStatusMessage"
                                       ActivityEditStatusMessage="@ActivityEditStatusMessage"
                                       TransportationStatusMessage="@TransportationStatusMessage"
                                       TransportationEditStatusMessage="@TransportationEditStatusMessage"
                                       AccommodationStatusMessage="@AccommodationStatusMessage"
                                       AccommodationEditStatusMessage="@AccommodationEditStatusMessage"
                                       ReservationStatusMessage="@ReservationStatusMessage" />
                <p class="workspace-private">Sensitive confirmation references, private notes, budgets, packing lists, and traveler identities are not included in this view.</p>
                </div>
                <PlannerContextualIdeasRail Context="@SelectedIdeasContext"
                                            AuthorizedItems="@AuthorizedFootSteps"
                                            CanEdit="@PlanCanEdit"
                                            ExpectedVersion="@Plan.Version"
                                            PlanStartDate="@Plan.Dates.Start"
                                            PlanEndDate="@Plan.Dates.End"
                                            ApplyDestinationPath="@ApplyDestinationFootStepPath"
                                            AddActivityPath="@AddActivityPath"
                                            ActivityTargets="@ActivityFootStepTargets"
                                            ApplicationStatusMessage="@FootStepStatusMessage"
                                            WidthPixels="@IdeasWidthPixels"
                                            OnAdventureContextRequested="SelectAdventureIdeasContextAsync"
                                            OnDestinationDragStarted="BeginDestinationFootStepDragAsync"
                                            OnDestinationDragEnded="EndDestinationFootStepDragAsync"
                                            OnDestinationDropped="ReviewDroppedDestinationFootStepAsync"
                                            OnActivityDragStarted="BeginActivityFootStepDragAsync"
                                            OnActivityDragEnded="EndActivityFootStepDragAsync"
                                            OnActivityDropped="ReviewDroppedActivityFootStepAsync"
                                            OnResizeRequested="ResizeIdeasAsync" />
                </div>
            </article>
        }
        else if (IsRootAdventureLanding)
        {
            <PlannerAdventureLauncher CreatorId="@AddressedCreatorId"
                                      Plans="@Plans" />
        }
        else
        {
            @if (TemplateStatusMessage is not null)
            {
                <p class="plan-create-status" role="status">@TemplateStatusMessage</p>
            }
            <PlannerJourneyStarter Templates="@AdventureTemplates"
                                   CreateFromTemplatePath="@CreateFromTemplatePath"
                                   OnTemplateModeChanged="SetTemplateModeAsync" />
            @if (!IsTemplateMode)
            {
            <section class="plan-create" aria-labelledby="create-plan">
                <p class="workspace-eyebrow">Private plan</p>
                <h2 id="create-plan">Review and create your plan</h2>
                <p>Start a private draft with a title and inclusive travel dates.</p>
                @if (CreateStatusMessage is not null)
                {
                    <p class="plan-create-status" role="status">@CreateStatusMessage</p>
                }
                <form method="post" action="@CreatePlanPath">
                    <AntiforgeryToken />
                    <input type="hidden" name="idempotencyKey" value="@CreateIdempotencyKey" />
                    <label>
                        Title
                        <input name="title" required maxlength="200" autocomplete="off" />
                    </label>
                    <label>
                        Description <span>(optional)</span>
                        <textarea name="description" maxlength="2000" rows="3"></textarea>
                    </label>
                    <div class="plan-create-dates">
                        <label>
                            Start date
                            <input type="date" name="startDate" required />
                        </label>
                        <label>
                            End date
                            <input type="date" name="endDate" required />
                        </label>
                    </div>
                    <button type="submit">Create private plan</button>
                </form>
            </section>
            }

            @if (Plans.Count == 0)
            {
                <PlannerWorkspaceState Kind="PlannerWorkspaceStateKind.Empty"
                                       Title="No active plans"
                                       Message="There are no active Adventure Plans in this private workspace yet." />
            }
            else
            {
                <section aria-labelledby="active-plans">
                <div class="workspace-section-heading">
                    <div>
                        <p class="workspace-eyebrow">Adventure dashboard</p>
                        <h2 id="active-plans">Active plans</h2>
                    </div>
                    <span>@Plans.Count @(Plans.Count == 1 ? "plan" : "plans")</span>
                </div>
                <div class="plan-grid">
                    @foreach (var plan in Plans)
                    {
                        <article class="plan-card">
                            <div class="plan-card-meta">
                                <span>@FormatStatus(plan.Status)</span>
                                <span>@plan.LifecycleStage</span>
                            </div>
                            <h3>@plan.Title</h3>
                            <dl>
                                <div><dt>Dates</dt><dd>@FormatDates(plan)</dd></div>
                                <div><dt>Plan version</dt><dd>@plan.Version</dd></div>
                            </dl>
                            <a class="plan-link" href="@PlanPath(plan.Id)">View plan <span aria-hidden="true">→</span></a>
                        </article>
                    }
                </div>
                </section>
            }
        }
    }
    else
    {
        <section class="workspace-sign-in" aria-labelledby="workspace-sign-in-title">
            <p class="workspace-sign-in__brand">AdventuresSuite</p>
            <p class="workspace-sign-in__eyebrow">Creator workspace</p>
            <h1 id="workspace-sign-in-title">Your adventures begin here.</h1>
            <p class="workspace-sign-in__description">
                Dream, plan, preserve, and publish meaningful adventures in one private workspace.
            </p>
            @if (IsDevelopmentAuthentication)
            {
                <form method="post" action="@DevelopmentSignInPath">
                    <AntiforgeryToken />
                    <button class="workspace-sign-in__action" type="submit">Sign in as the local alpha planner</button>
                </form>
            }
            else
            {
                <a class="workspace-sign-in__action"
                   href="@ExternalIdBrowserEndpoints.SignInPath"
                   data-enhance-nav="false">Sign in to your workspace</a>
            }
        </section>
    }
    </div>
    </ChildContent>
</PlannerWorkspaceShell>
