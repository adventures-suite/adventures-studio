@using AdventuresSuite.Identity.ExternalId
@using AdventuresSuite.Identity
@using TheSimontonAdventures.Web.Planning
@using TheSimontonAdventures.Web.Planning.Persistence
@using TheSimontonAdventures.Web.Creators

<PlannerWorkspaceShell Title="Planner workspace" Description="Private workspace and itinerary planning.">
    <ToolbarContent>
        @if (IsAuthenticated)
        {
            <form method="post" action="@ExternalIdBrowserEndpoints.SignOutPath">
                <AntiforgeryToken />
                <button class="workspace-signout" type="submit">Sign out</button>
            </form>
        }
    </ToolbarContent>
    <ChildContent>
    <div class="workspace-root">
    @if (IsAuthenticated)
    {
        <p class="workspace-private">You are signed in to the private workspace. Authorization is checked before plan data is read.</p>
        @if (LoadState == WorkspaceLoadState.Loading)
        {
            <PlannerWorkspaceState Kind="PlannerWorkspaceStateKind.Loading"
                                   Title="Loading your Adventure Plans…" />
        }
        else if (LoadState == WorkspaceLoadState.Unavailable)
        {
            <PlannerWorkspaceState Kind="PlannerWorkspaceStateKind.Unavailable"
                                   Title="Workspace unavailable"
                                   Message="Your account does not currently have access to this Planner workspace." />
        }
        else if (LoadState == WorkspaceLoadState.Failure)
        {
            <PlannerWorkspaceState Kind="PlannerWorkspaceStateKind.Failure"
                                   Title="Planner temporarily unavailable"
                                   Message="The private workspace could not be loaded. Please try again later." />
        }
        else if (LoadState == WorkspaceLoadState.Landing)
        {
            <PlannerWorkspaceState Kind="PlannerWorkspaceStateKind.Unavailable"
                                   Title="Choose a Creator workspace"
                                   Message="Open an explicitly addressed Creator workspace to view its Adventure Plans." />
        }
        else if (Plan is not null)
        {
            <article class="plan-detail">
                <a class="workspace-back" href="@PlanListPath">← Active plans</a>
                <header class="plan-detail-header">
                    <div>
                        <p class="workspace-eyebrow">@FormatStatus(Plan.Status) · @Plan.LifecycleStage</p>
                        <h2>@Plan.Title</h2>
                        @if (!string.IsNullOrWhiteSpace(Plan.WorkingDescription))
                        {
                            <p>@Plan.WorkingDescription</p>
                        }
                    </div>
                    <dl>
                        <div><dt>Dates</dt><dd>@FormatDates(Plan.Dates)</dd></div>
                        <div><dt>Travelers</dt><dd>@Plan.TravelerCount</dd></div>
                        <div><dt>Plan version</dt><dd>@Plan.Version</dd></div>
                    </dl>
                </header>

                @if (EditStatusMessage is not null)
                {
                    @if (IsEditConflict)
                    {
                        <PlannerWorkspaceState Kind="PlannerWorkspaceStateKind.Conflict"
                                               Title="Plan changed"
                                               Message="@EditStatusMessage" />
                    }
                    else
                    {
                        <p class="plan-create-status" role="status">@EditStatusMessage</p>
                    }
                }
                @if (PlanCanEdit)
                {
                    <section class="plan-create" aria-labelledby="edit-plan-overview">
                        <p class="workspace-eyebrow">Plan overview</p>
                        <h3 id="edit-plan-overview">Edit overview</h3>
                        <form method="post" action="@EditPlanPath">
                            <AntiforgeryToken />
                            <input type="hidden" name="expectedVersion" value="@Plan.Version" />
                            <label>
                                Title
                                <input name="title" value="@Plan.Title" required maxlength="200" autocomplete="off" />
                            </label>
                            <label>
                                Description <span>(optional)</span>
                                <textarea name="description" maxlength="2000" rows="3">@Plan.WorkingDescription</textarea>
                            </label>
                            <div class="plan-create-dates">
                                <label>
                                    Start date
                                    <input type="date" name="startDate" value="@Plan.Dates.Start.ToString("yyyy-MM-dd")" required />
                                </label>
                                <label>
                                    End date
                                    <input type="date" name="endDate" value="@Plan.Dates.End.ToString("yyyy-MM-dd")" required />
                                </label>
                            </div>
                            <button type="submit">Save overview</button>
                        </form>
                    </section>
                }

                <section aria-labelledby="plan-route">
                    <h3 id="plan-route">Destinations and route</h3>
                    @if (DestinationStatusMessage is not null)
                    {
                        <p class="plan-create-status" role="status">@DestinationStatusMessage</p>
                    }
                    @if (Plan.Destinations.Count == 0)
                    {
                        <p>No destinations have been added.</p>
                    }
                    else
                    {
                        <ol class="detail-list">
                            @foreach (var destination in Plan.Destinations)
                            {
                                <li>
                                    <strong>@destination.Name</strong>
                                    <span>@FormatDates(destination.Dates) · @destination.TimeZone</span>
                                </li>
                            }
                        </ol>
                    }
                    @if (PlanCanEdit)
                    {
                        <form class="plan-create" method="post" action="@AddDestinationPath">
                            <AntiforgeryToken />
                            <input type="hidden" name="expectedVersion" value="@Plan.Version" />
                            <label>
                                Destination name
                                <input name="name" required maxlength="200" autocomplete="off" />
                            </label>
                            <div class="plan-create-dates">
                                <label>
                                    Arrival date
                                    <input type="date" name="startDate" min="@Plan.Dates.Start.ToString("yyyy-MM-dd")" max="@Plan.Dates.End.ToString("yyyy-MM-dd")" required />
                                </label>
                                <label>
                                    Departure date
                                    <input type="date" name="endDate" min="@Plan.Dates.Start.ToString("yyyy-MM-dd")" max="@Plan.Dates.End.ToString("yyyy-MM-dd")" required />
                                </label>
                            </div>
                            <label>
                                Destination time zone
                                <input name="timeZoneId" required maxlength="100" placeholder="Europe/Rome" autocomplete="off" />
                            </label>
                            <button type="submit">Add destination</button>
                        </form>
                    }
                </section>

                <section aria-labelledby="plan-itinerary">
                    <h3 id="plan-itinerary">Daily itinerary</h3>
                    @if (ActivityStatusMessage is not null)
                    {
                        <p class="plan-create-status" role="status">@ActivityStatusMessage</p>
                    }
                    @if (DayStatusMessage is not null)
                    {
                        <p class="plan-create-status" role="status">@DayStatusMessage</p>
                    }
                    @if (Plan.Days.Count == 0)
                    {
                        <p>No itinerary days have been added.</p>
                    }
                    else
                    {
                        <div class="day-list">
                            @foreach (var day in Plan.Days)
                            {
                                <article>
                                    <p class="workspace-eyebrow">@day.Date.ToString("ddd, MMM d, yyyy") · @day.TimeZone</p>
                                    <h4>@day.Title</h4>
                                    @if (day.Activities.Count > 0)
                                    {
                                        <ul>
                                            @foreach (var activity in day.Activities)
                                            {
                                                <li><span>@FormatTimeRange(activity.StartsAtLocal, activity.EndsAtLocal)</span> @activity.Title <small>@FormatStatus(activity.Status)</small></li>
                                            }
                                        </ul>
                                    }
                                    @if (PlanCanEdit)
                                    {
                                        <form class="plan-create" method="post" action="@AddActivityPath">
                                            <AntiforgeryToken />
                                            <input type="hidden" name="expectedVersion" value="@Plan.Version" />
                                            <input type="hidden" name="itineraryDayId" value="@day.Id.Value" />
                                            <label>
                                                Proposed activity
                                                <input name="title" required maxlength="200" autocomplete="off" placeholder="Museum visit" />
                                            </label>
                                            <div class="plan-create-dates">
                                                <label>
                                                    Start time <span>(optional)</span>
                                                    <input type="time" name="startsAtLocal" />
                                                </label>
                                                <label>
                                                    End time <span>(optional)</span>
                                                    <input type="time" name="endsAtLocal" />
                                                </label>
                                            </div>
                                            <button type="submit">Add proposed activity</button>
                                        </form>
                                    }
                                </article>
                            }
                        </div>
                    }
                    @if (PlanCanEdit && Plan.Destinations.Count > 0)
                    {
                        <form class="plan-create" method="post" action="@AddDayPath">
                            <AntiforgeryToken />
                            <input type="hidden" name="expectedVersion" value="@Plan.Version" />
                            <label>
                                Destination visit
                                <select name="destinationVisitId" required>
                                    @foreach (var destination in Plan.Destinations)
                                    {
                                        <option value="@destination.Id.Value">@destination.Name · @FormatDates(destination.Dates)</option>
                                    }
                                </select>
                            </label>
                            <label>
                                Local date
                                <input type="date" name="date" min="@Plan.Dates.Start.ToString("yyyy-MM-dd")" max="@Plan.Dates.End.ToString("yyyy-MM-dd")" required />
                            </label>
                            <label>
                                Day title
                                <input name="title" required maxlength="200" autocomplete="off" placeholder="Arrival in Rome" />
                            </label>
                            <button type="submit">Add itinerary day</button>
                        </form>
                    }
                </section>

                <div class="detail-columns">
                    <section aria-labelledby="plan-transportation">
                        <h3 id="plan-transportation">Transportation</h3>
                        @if (TransportationStatusMessage is not null)
                        {
                            <p class="plan-create-status" role="status">@TransportationStatusMessage</p>
                        }
                        @if (Plan.Transportation.Count == 0)
                        {
                            <p>No transportation has been added.</p>
                        }
                        else
                        {
                            <ul class="detail-list">
                                @foreach (var segment in Plan.Transportation)
                                {
                                    <li><strong>@segment.Mode: @segment.From to @segment.To</strong><span>@segment.DepartureDate.ToString("MMM d, yyyy") · @FormatStatus(segment.Status)</span></li>
                                }
                            </ul>
                        }
                        @if (PlanCanEdit)
                        {
                            <form class="plan-create" method="post" action="@AddTransportationPath">
                                <AntiforgeryToken />
                                <input type="hidden" name="expectedVersion" value="@Plan.Version" />
                                <label>Mode<input name="mode" required maxlength="100" placeholder="Flight, rail, cruise, or car" /></label>
                                <label>From<input name="from" required maxlength="200" /></label>
                                <label>To<input name="to" required maxlength="200" /></label>
                                <div class="plan-create-dates">
                                    <label>Departure date<input type="date" name="departureDate" required /></label>
                                    <label>Departure time <span>(optional)</span><input type="time" name="departureTimeLocal" /></label>
                                </div>
                                <label>Departure time zone<input name="departureTimeZoneId" required maxlength="100" placeholder="America/Phoenix" /></label>
                                <div class="plan-create-dates">
                                    <label>Arrival date<input type="date" name="arrivalDate" required /></label>
                                    <label>Arrival time <span>(optional)</span><input type="time" name="arrivalTimeLocal" /></label>
                                </div>
                                <label>Arrival time zone<input name="arrivalTimeZoneId" required maxlength="100" placeholder="Europe/Rome" /></label>
                                <button type="submit">Add proposed transportation</button>
                            </form>
                        }
                    </section>
                    <section aria-labelledby="plan-accommodations">
                        <h3 id="plan-accommodations">Accommodations</h3>
                        @if (AccommodationStatusMessage is not null)
                        { <p class="plan-create-status" role="status">@AccommodationStatusMessage</p> }
                        @if (Plan.Accommodations.Count == 0)
                        {
                            <p>No accommodations have been added.</p>
                        }
                        else
                        {
                            <ul class="detail-list">
                                @foreach (var accommodation in Plan.Accommodations)
                                {
                                    <li><strong>@accommodation.Name</strong><span>@FormatDates(accommodation.Dates) · @FormatStatus(accommodation.Status)</span></li>
                                }
                            </ul>
                        }
                        @if (PlanCanEdit)
                        {
                            <form class="plan-create" method="post" action="@AddAccommodationPath">
                                <AntiforgeryToken />
                                <input type="hidden" name="expectedVersion" value="@Plan.Version" />
                                <label>Accommodation name<input name="name" required maxlength="200" /></label>
                                <div class="plan-create-dates">
                                    <label>Check-in date<input type="date" name="startDate" required /></label>
                                    <label>Check-out date<input type="date" name="endDate" required /></label>
                                </div>
                                <label>Property time zone<input name="timeZoneId" required maxlength="100" placeholder="Europe/Rome" /></label>
                                <button type="submit">Add proposed accommodation</button>
                            </form>
                        }
                    </section>
                </div>
                <section aria-labelledby="plan-reservations">
                    <h3 id="plan-reservations">Reservations</h3>
                    @if (ReservationStatusMessage is not null)
                    {
                        <p class="plan-create-status" role="status">@ReservationStatusMessage</p>
                    }
                    @if (Plan.Reservations.Count == 0)
                    {
                        <p>No reservation summaries have been added.</p>
                    }
                    else
                    {
                        <ul class="detail-list">
                            @foreach (var reservation in Plan.Reservations)
                            {
                                <li><strong>@reservation.Subject</strong><span>@FormatStatus(reservation.Status)</span></li>
                            }
                        </ul>
                    }
                    @if (PlanCanEdit)
                    {
                        <form class="plan-create" method="post" action="@AddReservationPath">
                            <AntiforgeryToken />
                            <input type="hidden" name="expectedVersion" value="@Plan.Version" />
                            <label>
                                Reservation subject
                                <input name="subject" required maxlength="200" autocomplete="off" placeholder="Hotel, tour, or transportation hold" />
                            </label>
                            <p>Confirmation references are added through a separate protected workflow.</p>
                            <button type="submit">Add proposed reservation</button>
                        </form>
                    }
                </section>
                <p class="workspace-private">Sensitive confirmation references, private notes, budgets, packing lists, and traveler identities are not included in this view.</p>
            </article>
        }
        else
        {
            <section class="plan-create" aria-labelledby="create-plan">
                <p class="workspace-eyebrow">Manual planning</p>
                <h2 id="create-plan">Create an Adventure Plan</h2>
                <p>Start a private draft with a title and inclusive travel dates.</p>
                @if (CreateStatusMessage is not null)
                {
                    <p class="plan-create-status" role="status">@CreateStatusMessage</p>
                }
                <form method="post" action="@CreatePlanPath">
                    <AntiforgeryToken />
                    <input type="hidden" name="idempotencyKey" value="@CreateIdempotencyKey" />
                    <label>
                        Title
                        <input name="title" required maxlength="200" autocomplete="off" />
                    </label>
                    <label>
                        Description <span>(optional)</span>
                        <textarea name="description" maxlength="2000" rows="3"></textarea>
                    </label>
                    <div class="plan-create-dates">
                        <label>
                            Start date
                            <input type="date" name="startDate" required />
                        </label>
                        <label>
                            End date
                            <input type="date" name="endDate" required />
                        </label>
                    </div>
                    <button type="submit">Create private plan</button>
                </form>
            </section>

            @if (Plans.Count == 0)
            {
                <PlannerWorkspaceState Kind="PlannerWorkspaceStateKind.Empty"
                                       Title="No active plans"
                                       Message="There are no active Adventure Plans in this private workspace yet." />
            }
            else
            {
                <section aria-labelledby="active-plans">
                <div class="workspace-section-heading">
                    <div>
                        <p class="workspace-eyebrow">Adventure dashboard</p>
                        <h2 id="active-plans">Active plans</h2>
                    </div>
                    <span>@Plans.Count @(Plans.Count == 1 ? "plan" : "plans")</span>
                </div>
                <div class="plan-grid">
                    @foreach (var plan in Plans)
                    {
                        <article class="plan-card">
                            <div class="plan-card-meta">
                                <span>@FormatStatus(plan.Status)</span>
                                <span>@plan.LifecycleStage</span>
                            </div>
                            <h3>@plan.Title</h3>
                            <dl>
                                <div><dt>Dates</dt><dd>@FormatDates(plan)</dd></div>
                                <div><dt>Plan version</dt><dd>@plan.Version</dd></div>
                            </dl>
                            <a class="plan-link" href="@PlanPath(plan.Id)">View plan <span aria-hidden="true">→</span></a>
                        </article>
                    }
                </div>
                </section>
            }
        }
    }
    else
    {
        <p>Sign in to access the private workspace.</p>
        <a href="@ExternalIdBrowserEndpoints.SignInPath"
           data-enhance-nav="false">Sign in</a>
    }
    </div>
    </ChildContent>
</PlannerWorkspaceShell>
