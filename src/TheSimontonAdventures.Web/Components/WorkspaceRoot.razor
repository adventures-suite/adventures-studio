@using AdventuresSuite.Identity.ExternalId
@using AdventuresSuite.Identity
@using TheSimontonAdventures.Web.Planning
@using TheSimontonAdventures.Web.Planning.Persistence
@using TheSimontonAdventures.Web.Creators
@inject IHttpContextAccessor HttpContextAccessor

<main class="workspace-root">
    <header class="workspace-header">
        <div>
            <p class="workspace-eyebrow">AdventuresSuite</p>
            <h1>Planner workspace</h1>
        </div>
        @if (IsAuthenticated)
        {
            <form method="post" action="@ExternalIdBrowserEndpoints.SignOutPath">
                <AntiforgeryToken />
                <button class="workspace-signout" type="submit">Sign out</button>
            </form>
        }
    </header>
    @if (IsAuthenticated)
    {
        <p class="workspace-private">You are signed in to the private workspace. Authorization is checked before plan data is read.</p>
        @if (LoadState == WorkspaceLoadState.Loading)
        {
            <p role="status">Loading your Adventure Plans…</p>
        }
        else if (LoadState == WorkspaceLoadState.Unavailable)
        {
            <section class="workspace-message" aria-labelledby="workspace-unavailable">
                <h2 id="workspace-unavailable">Workspace unavailable</h2>
                <p>Your account does not currently have access to this Planner workspace.</p>
            </section>
        }
        else if (LoadState == WorkspaceLoadState.Failure)
        {
            <section class="workspace-message" aria-labelledby="workspace-failure">
                <h2 id="workspace-failure">Planner temporarily unavailable</h2>
                <p>The private workspace could not be loaded. Please try again later.</p>
            </section>
        }
        else if (LoadState == WorkspaceLoadState.Landing)
        {
            <section class="workspace-message" aria-labelledby="workspace-landing">
                <h2 id="workspace-landing">Choose a Creator workspace</h2>
                <p>Open an explicitly addressed Creator workspace to view its Adventure Plans.</p>
            </section>
        }
        else if (Plan is not null)
        {
            <article class="plan-detail">
                <a class="workspace-back" href="@PlanListPath">← Active plans</a>
                <header class="plan-detail-header">
                    <div>
                        <p class="workspace-eyebrow">@FormatStatus(Plan.Status) · @Plan.LifecycleStage</p>
                        <h2>@Plan.Title</h2>
                        @if (!string.IsNullOrWhiteSpace(Plan.WorkingDescription))
                        {
                            <p>@Plan.WorkingDescription</p>
                        }
                    </div>
                    <dl>
                        <div><dt>Dates</dt><dd>@FormatDates(Plan.Dates)</dd></div>
                        <div><dt>Travelers</dt><dd>@Plan.TravelerCount</dd></div>
                        <div><dt>Plan version</dt><dd>@Plan.Version</dd></div>
                    </dl>
                </header>

                <section aria-labelledby="plan-route">
                    <h3 id="plan-route">Destinations and route</h3>
                    @if (Plan.Destinations.Count == 0)
                    {
                        <p>No destinations have been added.</p>
                    }
                    else
                    {
                        <ol class="detail-list">
                            @foreach (var destination in Plan.Destinations)
                            {
                                <li>
                                    <strong>@destination.Name</strong>
                                    <span>@FormatDates(destination.Dates) · @destination.TimeZone</span>
                                </li>
                            }
                        </ol>
                    }
                </section>

                <section aria-labelledby="plan-itinerary">
                    <h3 id="plan-itinerary">Daily itinerary</h3>
                    @if (Plan.Days.Count == 0)
                    {
                        <p>No itinerary days have been added.</p>
                    }
                    else
                    {
                        <div class="day-list">
                            @foreach (var day in Plan.Days)
                            {
                                <article>
                                    <p class="workspace-eyebrow">@day.Date.ToString("ddd, MMM d, yyyy") · @day.TimeZone</p>
                                    <h4>@day.Title</h4>
                                    @if (day.Activities.Count > 0)
                                    {
                                        <ul>
                                            @foreach (var activity in day.Activities)
                                            {
                                                <li><span>@FormatTimeRange(activity.StartsAtLocal, activity.EndsAtLocal)</span> @activity.Title <small>@FormatStatus(activity.Status)</small></li>
                                            }
                                        </ul>
                                    }
                                </article>
                            }
                        </div>
                    }
                </section>

                <div class="detail-columns">
                    <section aria-labelledby="plan-transportation">
                        <h3 id="plan-transportation">Transportation</h3>
                        @if (Plan.Transportation.Count == 0)
                        {
                            <p>No transportation has been added.</p>
                        }
                        else
                        {
                            <ul class="detail-list">
                                @foreach (var segment in Plan.Transportation)
                                {
                                    <li><strong>@segment.Mode: @segment.From to @segment.To</strong><span>@segment.DepartureDate.ToString("MMM d, yyyy") · @FormatStatus(segment.Status)</span></li>
                                }
                            </ul>
                        }
                    </section>
                    <section aria-labelledby="plan-accommodations">
                        <h3 id="plan-accommodations">Accommodations</h3>
                        @if (Plan.Accommodations.Count == 0)
                        {
                            <p>No accommodations have been added.</p>
                        }
                        else
                        {
                            <ul class="detail-list">
                                @foreach (var accommodation in Plan.Accommodations)
                                {
                                    <li><strong>@accommodation.Name</strong><span>@FormatDates(accommodation.Dates) · @FormatStatus(accommodation.Status)</span></li>
                                }
                            </ul>
                        }
                    </section>
                </div>
                <p class="workspace-private">Sensitive reservation references, private notes, budgets, packing lists, and traveler identities are not included in this view.</p>
            </article>
        }
        else if (Plans.Count == 0)
        {
            <section class="workspace-message" aria-labelledby="workspace-empty">
                <h2 id="workspace-empty">No active plans</h2>
                <p>There are no active Adventure Plans in this private workspace yet.</p>
            </section>
        }
        else
        {
            <section aria-labelledby="active-plans">
                <div class="workspace-section-heading">
                    <div>
                        <p class="workspace-eyebrow">Adventure dashboard</p>
                        <h2 id="active-plans">Active plans</h2>
                    </div>
                    <span>@Plans.Count @(Plans.Count == 1 ? "plan" : "plans")</span>
                </div>
                <div class="plan-grid">
                    @foreach (var plan in Plans)
                    {
                        <article class="plan-card">
                            <div class="plan-card-meta">
                                <span>@FormatStatus(plan.Status)</span>
                                <span>@plan.LifecycleStage</span>
                            </div>
                            <h3>@plan.Title</h3>
                            <dl>
                                <div><dt>Dates</dt><dd>@FormatDates(plan)</dd></div>
                                <div><dt>Plan version</dt><dd>@plan.Version</dd></div>
                            </dl>
                            <a class="plan-link" href="@PlanPath(plan.Id)">View plan <span aria-hidden="true">→</span></a>
                        </article>
                    }
                </div>
            </section>
        }
    }
    else
    {
        <p>Sign in to access the private workspace.</p>
        <a href="@ExternalIdBrowserEndpoints.SignInPath"
           data-enhance-nav="false">Sign in</a>
    }
</main>

@code {
    private IReadOnlyList<AdventurePlanDashboardItem> Plans { get; set; } = [];
    private AdventurePlanDetail? Plan { get; set; }
    private CreatorId AddressedCreatorId { get; set; }
    private WorkspaceLoadState LoadState { get; set; } = WorkspaceLoadState.Landing;

    private bool IsAuthenticated =>
        HttpContextAccessor.HttpContext?.User.Identity?.IsAuthenticated is true;

    protected override async Task OnInitializedAsync()
    {
        var context = HttpContextAccessor.HttpContext;
        if (context?.User.Identity?.IsAuthenticated is not true)
        {
            return;
        }

        if (!TryGetAddressedRoute(context.Request.Path, out var creatorId, out var planId))
        {
            LoadState = WorkspaceLoadState.Landing;
            return;
        }

        LoadState = WorkspaceLoadState.Loading;
        var actorResolver = context.RequestServices.GetService<IWorkspaceActorResolver>();
        var query = context.RequestServices.GetService<IPlannerWorkspaceQueryService>();
        var actor = actorResolver?.Resolve(context.User);
        if (query is null || actor is null)
        {
            LoadState = WorkspaceLoadState.Unavailable;
            return;
        }

        try
        {
            AddressedCreatorId = creatorId;
            if (planId.HasValue)
            {
                var result = await query.GetAsync(actor, creatorId, planId.Value, context.RequestAborted);
                Plan = result.Plan;
                LoadState = result.IsAllowed ? WorkspaceLoadState.Ready : WorkspaceLoadState.Unavailable;
            }
            else
            {
                var result = await query.ListAsync(actor, creatorId, context.RequestAborted);
                Plans = result.Plans;
                LoadState = result.IsAllowed ? WorkspaceLoadState.Ready : WorkspaceLoadState.Unavailable;
            }
        }
        catch (OperationCanceledException) when (context.RequestAborted.IsCancellationRequested)
        {
            throw;
        }
        catch (Exception exception)
        {
            context.RequestServices.GetService<ILogger<WorkspaceRoot>>()?.LogError(
                exception,
                "Planner dashboard read failed before a safe response could be rendered.");
            LoadState = WorkspaceLoadState.Failure;
        }
    }

    private static bool TryGetAddressedRoute(
        PathString path,
        out CreatorId creatorId,
        out AdventurePlanId? planId)
    {
        creatorId = default;
        planId = null;
        var segments = path.Value?.Split('/', StringSplitOptions.None);
        if (segments is null
            || segments.Length is not (5 or 6)
            || segments[0] != string.Empty
            || segments[1] != "workspace"
            || segments[2] != "creators"
            || segments[4] != "plans")
        {
            return false;
        }

        try
        {
            creatorId = new CreatorId(segments[3]);
            if (segments.Length == 6)
            {
                planId = new AdventurePlanId(segments[5]);
            }
            return true;
        }
        catch (ArgumentException)
        {
            return false;
        }
    }

    private string PlanListPath => $"/workspace/creators/{AddressedCreatorId.Value}/plans";
    private string PlanPath(AdventurePlanId planId) => $"{PlanListPath}/{planId.Value}";
    private static string FormatDates(AdventurePlanDashboardItem plan) => FormatDates(plan.Dates);
    private static string FormatDates(PlanningDateRange dates) =>
        $"{dates.Start:MMM d, yyyy} – {dates.End:MMM d, yyyy}";

    private static string FormatTimeRange(TimeOnly? start, TimeOnly? end) => (start, end) switch
    {
        ({ } startTime, { } endTime) => $"{startTime:h:mm tt}–{endTime:h:mm tt}",
        ({ } startTime, null) => startTime.ToString("h:mm tt"),
        _ => "Time flexible"
    };

    private static string FormatStatus(PlanningStatus status) => status switch
    {
        PlanningStatus.InProgress => "In progress",
        _ => status.ToString()
    };

    private static string FormatStatus(PlanItemStatus status) => status.ToString();

    private enum WorkspaceLoadState { Landing, Loading, Ready, Unavailable, Failure }
}
