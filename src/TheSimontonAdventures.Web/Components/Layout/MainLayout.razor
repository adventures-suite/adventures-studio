@inherits LayoutComponentBase
@inject ICreatorContextAccessor CreatorContextAccessor

<div class="site-shell"
     style="@BrandStyle">
    <SiteHeader CreatorContext="@CreatorContextAccessor.Current" />

    <main class="site-main">
        @Body
    </main>

    <footer class="site-footer">
        <span>&copy; @CreatorContextAccessor.Current.GetLocalYear() @CreatorContextAccessor.Current.GetCopyrightNotice()</span>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string BrandStyle =>
        $"--creator-primary: {CreatorContextAccessor.Current.Brand.PrimaryColor}; " +
        $"--creator-accent: {CreatorContextAccessor.Current.Brand.AccentColor}; " +
        $"--creator-font-family: {CreatorContextAccessor.Current.GetFontFamily()}";
}
