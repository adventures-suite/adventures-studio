@using TheSimontonAdventures.Web.Models

<section class="volume-hero"
         style="@GetBackgroundStyle()">

    <div class="volume-hero__overlay"></div>

    <div class="volume-hero__content">
        <p class="volume-hero__status">
            @Volume.Status.GetDisplayLabel()
        </p>

        <p class="volume-hero__number">
            Volume @ToRomanNumeral(Volume.Number)
        </p>

        <h1>@Volume.Title</h1>

        @if (!string.IsNullOrWhiteSpace(Volume.Subtitle))
        {
            <p class="volume-hero__subtitle">
                @Volume.Subtitle
            </p>
        }

        @if (!string.IsNullOrWhiteSpace(Volume.TravelDates))
        {
            <p class="volume-hero__dates">
                @Volume.TravelDates
            </p>
        }

        @if (!string.IsNullOrWhiteSpace(Volume.Description))
        {
            <p class="volume-hero__description">
                @Volume.Description
            </p>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public Volume Volume { get; set; } = null!;

    private string GetBackgroundStyle()
    {
        if (string.IsNullOrWhiteSpace(Volume.HeroImage))
        {
            return string.Empty;
        }

        return $"background-image: url('{Volume.HeroImage}');";
    }

    private static string ToRomanNumeral(int number)
    {
        return number switch
        {
            1 => "I",
            2 => "II",
            3 => "III",
            4 => "IV",
            5 => "V",
            _ => number.ToString()
        };
    }
}