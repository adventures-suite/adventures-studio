@using TheSimontonAdventures.Web.Models

<section class="volume-planning">
    <div class="volume-planning__content">
        <p class="destination-eyebrow">
            @Volume.Status.GetDisplayLabel()
        </p>

        <h2>The Adventure Is Taking Shape</h2>

        @if (!string.IsNullOrWhiteSpace(
            Volume.StatusMessage))
        {
            <p class="volume-planning__message">
                @Volume.StatusMessage
            </p>
        }

        <p>
            We will continue adding routes, destinations, photographs,
            planning notes, and travel details as this journey develops.
        </p>

        <a href="/">
            Return to our adventures
            <span aria-hidden="true">→</span>
        </a>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public Volume Volume { get; set; } = null!;
}