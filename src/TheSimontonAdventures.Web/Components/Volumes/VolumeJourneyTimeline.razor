@using TheSimontonAdventures.Web.Models

@if (Volume.JourneyStops.Count > 0)
{
    <section class="volume-journey">
        <header class="volume-journey__header">
            <p class="destination-eyebrow">The journey</p>
            <h2>Follow the Route</h2>
        </header>

        <div class="volume-journey__track">
            @foreach (var stop in Volume.JourneyStops
                .OrderBy(item => item.DisplayOrder))
            {
                var url = GetStopUrl(stop);

                @if (string.IsNullOrWhiteSpace(url))
                {
                    <div class="volume-journey__stop">
                        @RenderStop(stop)
                    </div>
                }
                else
                {
                    <a class="volume-journey__stop"
                       href="@url">
                        @RenderStop(stop)
                    </a>
                }
            }
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired]
    public Volume Volume { get; set; } = null!;

    private string GetStopUrl(JourneyStop stop)
    {
        if (string.IsNullOrWhiteSpace(stop.CountrySlug)
            || string.IsNullOrWhiteSpace(stop.DestinationSlug))
        {
            return string.Empty;
        }

        return $"/volumes/{Volume.Slug}/" +
               $"{stop.CountrySlug}/{stop.DestinationSlug}";
    }

    private RenderFragment RenderStop(JourneyStop stop) => @<text>
        <span class="volume-journey__icon"
              aria-hidden="true">
            @stop.Icon
        </span>

        <span class="volume-journey__text">
            <strong>@stop.Title</strong>
            <small>@stop.Subtitle</small>
        </span>
    </text>;
}