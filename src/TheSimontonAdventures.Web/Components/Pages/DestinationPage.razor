@page "/volumes/{VolumeSlug}/{CountrySlug}/{DestinationSlug}"
@using TheSimontonAdventures.Web.Models
@using TheSimontonAdventures.Web.Components.Platform
@inject ITravelContentService TravelContentService
@inject ICreatorContextAccessor CreatorContextAccessor

<PageTitle>@PageTitle</PageTitle>

@if (_isLoading)
{
    <main>
        <LoadingState Message="Loading destination…" />
    </main>
}
else if (_destination is null)
{
    <main>
        <h1>Destination not found</h1>
        <p>The requested destination could not be found.</p>
    </main>
}
else
{
    <DestinationHero Destination="_destination" />

    <main class="destination-content">
        <DestinationIntroduction Destination="_destination" />

        <DestinationJourneyTimeline Destination="_destination" />

        <DestinationStory
            Sections="_destination.Sections"
            Reflections="_destination.Reflections" />

        <DestinationGuide
            Facts="_destination.Facts"
            Highlights="_destination.Highlights"
            Tips="_destination.Tips" />

        <DestinationGallery Images="_destination.Gallery" />

        <DestinationMap Map="_destination.Map" />

        @if (CreatorContextAccessor.Current.Features.EnableCompanion)
        {
            <AdventuresCompanion DestinationName="@_destination.Title" />
        }
    </main>
    
    <ContinueTheJourney Destination="_destination" />

    <DestinationNavigation Destination="_destination" />
}

@code {
    /// <summary>Gets or sets the volume segment captured from the route.</summary>
    [Parameter]
    public string VolumeSlug { get; set; } = string.Empty;

    /// <summary>Gets or sets the country segment captured from the route.</summary>
    [Parameter]
    public string CountrySlug { get; set; } = string.Empty;

    /// <summary>Gets or sets the destination segment captured from the route.</summary>
    [Parameter]
    public string DestinationSlug { get; set; } = string.Empty;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private Destination? _destination;
    private bool _isLoading;

    private string PageTitle =>
        _destination is null
            ? $"Destination | {CreatorContextAccessor.Current.GetSiteName()}"
            : $"{_destination.Title} | " +
              CreatorContextAccessor.Current.GetSiteName();

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;

        var creatorId = CreatorContextAccessor.Current.Id;
        var volume = await TravelContentService.GetVolumeAsync(
            creatorId,
            VolumeSlug);
        var destination = await TravelContentService.GetDestinationAsync(
            creatorId,
            VolumeSlug,
            CountrySlug,
            DestinationSlug);

        _destination = PublicContentPolicy.IsPublic(volume, destination)
            ? destination
            : null;

        if (_destination is null
            && HttpContext is not null
            && !HttpContext.Response.HasStarted)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
        }

        _isLoading = false;
    }
}
