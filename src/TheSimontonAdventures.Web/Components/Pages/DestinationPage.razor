@page "/volumes/{VolumeSlug}/{CountrySlug}/{DestinationSlug}"
@using TheSimontonAdventures.Web.Models
@using TheSimontonAdventures.Web.Components.Platform
@inject ITravelContentService TravelContentService
@inject ICreatorContextAccessor CreatorContextAccessor
@inject IResourceService ResourceService

<PageTitle>@PageTitle</PageTitle>

@if (_isLoading)
{
    <main>
        <LoadingState Message="Loading destination…" />
    </main>
}
else if (_destination is null)
{
    <main>
        <h1>Destination not found</h1>
        <p>The requested destination could not be found.</p>
    </main>
}
else
{
    <DestinationHero Destination="_destination"
                     HeroImageUrl="@(_heroImage?.PublicUrl ?? string.Empty)"
                     HeroImageAlt="@(_heroImage?.Resource.AlternativeText ?? string.Empty)" />

    <main class="destination-content">
        <DestinationIntroduction Destination="_destination" />

        <DestinationJourneyTimeline Destination="_destination" />

        <DestinationStory
            Sections="_storySections"
            Reflections="_destination.Reflections" />

        <DestinationGuide
            Facts="_destination.Facts"
            Highlights="_destination.Highlights"
            Tips="_destination.Tips" />

        <DestinationGallery Images="_galleryImages" />

        <DestinationMap Map="_destination.Map" />

        @if (CreatorContextAccessor.Current.Features.EnableCompanion)
        {
            <AdventuresCompanion DestinationName="@_destination.Title" />
        }
    </main>
    
    <ContinueTheJourney Destination="_destination" />

    <DestinationNavigation Destination="_destination" />
}

@code {
    /// <summary>Gets or sets the volume segment captured from the route.</summary>
    [Parameter]
    public string VolumeSlug { get; set; } = string.Empty;

    /// <summary>Gets or sets the country segment captured from the route.</summary>
    [Parameter]
    public string CountrySlug { get; set; } = string.Empty;

    /// <summary>Gets or sets the destination segment captured from the route.</summary>
    [Parameter]
    public string DestinationSlug { get; set; } = string.Empty;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private Destination? _destination;
    private ResolvedResource? _heroImage;
    private IReadOnlyList<GalleryImage> _galleryImages = [];
    private IReadOnlyList<DestinationSection> _storySections = [];
    private bool _isLoading;

    private string PageTitle =>
        _destination is null
            ? $"Destination | {CreatorContextAccessor.Current.GetSiteName()}"
            : $"{_destination.Title} | " +
              CreatorContextAccessor.Current.GetSiteName();

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;

        var creatorId = CreatorContextAccessor.Current.Id;
        var volume = await TravelContentService.GetVolumeAsync(
            creatorId,
            VolumeSlug);
        var destination = await TravelContentService.GetDestinationAsync(
            creatorId,
            VolumeSlug,
            CountrySlug,
            DestinationSlug);

        _destination = PublicContentPolicy.IsPublic(volume, destination)
            ? destination
            : null;

        _heroImage = _destination is null
            ? null
            : await ResourceService.ResolvePublicAsync(
                creatorId,
                _destination.HeroResourceId);
        _galleryImages = _destination is null
            ? []
            : await ResolveGalleryImagesAsync(creatorId, _destination.Gallery);
        _storySections = _destination is null
            ? []
            : await ResolveStorySectionsAsync(creatorId, _destination.Sections);

        if (_destination is null
            && HttpContext is not null
            && !HttpContext.Response.HasStarted)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
        }

        _isLoading = false;
    }

    private async Task<IReadOnlyList<GalleryImage>> ResolveGalleryImagesAsync(
        CreatorId creatorId,
        IReadOnlyList<GalleryImage> images)
    {
        var resolved = await Task.WhenAll(images.Select(async image =>
        {
            var resource = await ResourceService.ResolvePublicAsync(creatorId, image.ResourceId);
            return new GalleryImage
            {
                ResourceId = image.ResourceId,
                PublicUrl = resource?.PublicUrl ?? string.Empty,
                AlternativeText = resource?.Resource.AlternativeText ?? string.Empty,
                Caption = image.Caption,
                DisplayOrder = image.DisplayOrder
            };
        }));
        return resolved;
    }

    private async Task<IReadOnlyList<DestinationSection>> ResolveStorySectionsAsync(
        CreatorId creatorId,
        IReadOnlyList<DestinationSection> sections)
    {
        var resolved = await Task.WhenAll(sections.Select(async section =>
        {
            var resource = section.ImageResourceId is null
                ? null
                : await ResourceService.ResolvePublicAsync(creatorId, section.ImageResourceId.Value);
            return new DestinationSection
            {
                Heading = section.Heading,
                Paragraphs = section.Paragraphs,
                ImageResourceId = section.ImageResourceId,
                ResolvedImageUrl = resource?.PublicUrl ?? string.Empty,
                ResolvedImageAlternativeText = resource?.Resource.AlternativeText ?? string.Empty,
                ImageCaption = section.ImageCaption
            };
        }));
        return resolved;
    }
}
