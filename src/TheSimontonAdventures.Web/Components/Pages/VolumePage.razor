@page "/volumes/{VolumeSlug}"

@using TheSimontonAdventures.Web.Models
@using TheSimontonAdventures.Web.Components.Volume
@using TheSimontonAdventures.Web.Components.Journeys

@inject ITravelContentService TravelContentService

<PageTitle>@PageTitle</PageTitle>

@if (_isLoading)
{
    <main class="volume-page">
        <p>Loading adventure...</p>
    </main>
}
else if (_volume is null)
{
    <main class="volume-page">
        <h1>Adventure not found</h1>
    </main>
}
else
{
    <main class="volume-page">

        <section class="volume-hero">

            @if (!string.IsNullOrWhiteSpace(_volume.CoverImage))
            {
                <div class="volume-hero__image">
                    <img src="@_volume.CoverImage"
                         alt="@BuildVolumeHeroAltText()"
                         loading="eager" />
                </div>
            }

            <div class="volume-hero__content">

                <span class="volume-eyebrow">
                    The Simonton Adventures
                </span>

                <h1>
                    @_volume.Title
                </h1>

                @if (!string.IsNullOrWhiteSpace(_volume.Subtitle))
                {
                    <h2>
                        @_volume.Subtitle
                    </h2>
                }

                @if (!string.IsNullOrWhiteSpace(_volume.TravelDates))
                {
                    <p class="volume-travel-dates">
                        @_volume.TravelDates
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(_volume.Description))
                {
                    <p class="volume-description">
                        @_volume.Description
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(_volume.StatusMessage))
                {
                    <p class="volume-status-message">
                        @_volume.StatusMessage
                    </p>
                }

            </div>

        </section>

        @if (_journey is not null)
        {
            <JourneySegmentTimeline Journey="@_journey" />
        }

        <VolumeDestinations
            Destinations="@_destinationCards"
            VolumeSlug="@_volume.Slug" />

    </main>
}

@code {
    [Parameter]
    public string VolumeSlug { get; set; } = string.Empty;

    private TheSimontonAdventures.Web.Models.Volume? _volume;

    private Journey? _journey;

    private IReadOnlyList<VolumeDestinationCard> _destinationCards =
        Array.Empty<VolumeDestinationCard>();

    private bool _isLoading;

    private string PageTitle =>
        _volume is null
            ? "Adventure"
            : _volume.Title;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _volume = null;
        _journey = null;
        _destinationCards = Array.Empty<VolumeDestinationCard>();

        try
        {
            _volume = await TravelContentService.GetVolumeAsync(VolumeSlug);

            if (_volume is null)
            {
                return;
            }

            var featuredJourneyReference = _volume.Journeys
                .Where(reference => reference.Featured)
                .OrderBy(reference => reference.DisplayOrder)
                .FirstOrDefault();

            if (featuredJourneyReference is not null)
            {
                _journey = await TravelContentService.GetJourneyAsync(
                    _volume.Slug,
                    featuredJourneyReference.Slug);
            }

            var cardTasks = _volume.Destinations
                .OrderBy(reference => reference.DisplayOrder)
                .Select(reference => LoadDestinationCardAsync(
                    _volume.Slug,
                    reference));

            var cards = await Task.WhenAll(cardTasks);

            _destinationCards = cards
                .Where(card => card is not null)
                .Select(card => card!)
                .OrderBy(card => card.DisplayOrder)
                .ToArray();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task<VolumeDestinationCard?> LoadDestinationCardAsync(
        string volumeSlug,
        VolumeDestinationReference reference)
    {
        var destination = await TravelContentService.GetDestinationAsync(
            volumeSlug,
            reference.CountrySlug,
            reference.DestinationSlug);

        if (destination is null)
        {
            return null;
        }

        return new VolumeDestinationCard
        {
            CountrySlug = reference.CountrySlug,
            DestinationSlug = reference.DestinationSlug,
            Title = destination.Title,
            CountryName = destination.Country,
            HeroImage = ResolveDestinationCardImage(destination),
            Summary = ResolveDestinationCardSummary(destination),
            DisplayOrder = reference.DisplayOrder
        };
    }

    private static string ResolveDestinationCardImage(
        Destination destination)
    {
        if (!string.IsNullOrWhiteSpace(destination.HomepageImage))
        {
            return destination.HomepageImage;
        }

        return destination.HeroImage;
    }

    private static string ResolveDestinationCardSummary(
        Destination destination)
    {
        if (!string.IsNullOrWhiteSpace(destination.HomepageSummary))
        {
            return destination.HomepageSummary;
        }

        return destination.Summary;
    }

    private string BuildVolumeHeroAltText()
    {
        if (_volume is null)
        {
            return string.Empty;
        }

        return string.IsNullOrWhiteSpace(_volume.Subtitle)
            ? _volume.Title
            : $"{_volume.Title}: {_volume.Subtitle}";
    }
}