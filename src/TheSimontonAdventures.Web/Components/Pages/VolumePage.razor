@page "/volumes/{VolumeSlug}"

@using TheSimontonAdventures.Web.Models
@using TheSimontonAdventures.Web.Components.Shared
@using TheSimontonAdventures.Web.Components.Volume

@inject ITravelContentService TravelContentService

<PageTitle>@PageTitle</PageTitle>

@if (_isLoading)
{
    <main class="volume-page">
        <p>Loading adventure...</p>
    </main>
}
else if (_volume is null)
{
    <main class="volume-page">
        <h1>Adventure not found</h1>
    </main>
}
else
{
    <main class="volume-page">

        <section class="volume-hero">

            <span class="volume-eyebrow">
                The Simonton Adventures
            </span>

            <h1>
                @_volume.Title
            </h1>

            @if (!string.IsNullOrWhiteSpace(_volume.Subtitle))
            {
                <h2>
                    @_volume.Subtitle
                </h2>
            }

            @if (!string.IsNullOrWhiteSpace(_volume.Description))
            {
                <p class="volume-description">
                    @_volume.Description
                </p>
            }

        </section>

        <JourneyTimeline Stops="@_volume.JourneyStops" />

        <VolumeDestinations
            Destinations="@_destinationCards"
            VolumeSlug="@_volume.Slug" />

    </main>
}

@code {

    [Parameter]
    public string VolumeSlug { get; set; } = string.Empty;

    private Volume? _volume;

    private IReadOnlyList<VolumeDestinationCard> _destinationCards = Array.Empty<VolumeDestinationCard>();

    private bool _isLoading;

    private string PageTitle =>
        _volume is null
            ? "Adventure"
            : _volume.Title;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;

        try
        {
            _volume = await TravelContentService.GetVolumeAsync(VolumeSlug);

            if (_volume is null)
            {
                _destinationCards = Array.Empty<VolumeDestinationCard>();
                return;
            }

            var cardTasks = _volume.Destinations
                .OrderBy(reference => reference.DisplayOrder)
                .Select(reference => LoadDestinationCardAsync(
                    _volume.Slug,
                    reference));

            var cards = await Task.WhenAll(cardTasks);

            _destinationCards = cards
                .Where(card => card is not null)
                .Select(card => card!)
                .OrderBy(card => card.DisplayOrder)
                .ToArray();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task<VolumeDestinationCard?> LoadDestinationCardAsync(
    string volumeSlug,
    VolumeDestinationReference reference)
    {
        var destination = await TravelContentService.GetDestinationAsync(
            volumeSlug,
            reference.CountrySlug,
            reference.DestinationSlug);

        if (destination is null)
        {
            return null;
        }

        return new VolumeDestinationCard
        {
            CountrySlug = reference.CountrySlug,
            DestinationSlug = reference.DestinationSlug,
            Title = destination.Title,
            CountryName = destination.Country,
            HeroImage = string.IsNullOrWhiteSpace(destination.HomepageImage)
                ? destination.HeroImage
                : destination.HomepageImage,
            Summary = string.IsNullOrWhiteSpace(destination.HomepageSummary)
                ? destination.Summary
                : destination.HomepageSummary,
            DisplayOrder = reference.DisplayOrder
        };
    }

    private static string FormatSlug(string slug)
    {
        if (string.IsNullOrWhiteSpace(slug))
        {
            return string.Empty;
        }

        return string.Join(
            ' ',
            slug.Split(
                    '-',
                    StringSplitOptions.RemoveEmptyEntries |
                    StringSplitOptions.TrimEntries)
                .Select(word =>
                    char.ToUpperInvariant(word[0]) + word[1..]));
    }
}