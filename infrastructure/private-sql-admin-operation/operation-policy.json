{
  "schemaVersion": 1,
  "deadlineMinutes": 30,
  "automaticRetryCount": 0,
  "baselineMustPrecedeBootstrap": true,
  "baselineCanInvokeBootstrap": false,
  "successfulBaselineOutcomes": ["complete", "absent"],
  "failureOutcomes": ["unexpected", "ambiguous", "timeout", "cancelled", "runnerLost", "identityMismatch", "authorityMismatch", "evidenceRejected", "cleanupPartial"],
  "cleanup": {
    "independent": true,
    "requiredAfter": ["success", "failure", "timeout", "cancelled", "runnerLost", "ambiguous"],
    "successRequiresZero": ["resourceCount", "registrationCount", "temporaryAssignmentCount", "guestFileCount"]
  },
  "operations": ["baseline", "bootstrap", "bootstrap-policy-role", "bootstrap-initial-owner", "cleanup", "denial-proof"],
  "authorityBoundaries": ["administratorIdentityAndFic", "temporarySqlAdministrator", "sqlBootstrap", "sqlCleanupAndDenialProof"],
  "prohibitedNetworkChanges": ["publicSql", "firewallException", "publicIp", "inboundSsh", "inboundRdp", "legacyAdministrationVm", "snet-devtools"]
}
