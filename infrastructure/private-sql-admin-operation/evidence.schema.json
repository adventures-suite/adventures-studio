{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdventuresSuite private SQL administrator baseline evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "binding", "outcome", "journal", "schemas", "roles", "principals", "permissions", "objectCounts", "residue"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["repositoryId", "organizationId", "sourceSha", "workflowSha256", "operationId", "packageRunId", "packageArtifactId", "packageSha256", "catalogSha256", "administratorIdentityResourceIdSha256", "serverResourceIdSha256", "databaseName", "privateEndpointResourceIdSha256"],
      "properties": {
        "repositoryId": { "const": 1317655952 },
        "organizationId": { "const": 316268438 },
        "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "workflowSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "operationId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,31}$" },
        "packageRunId": { "type": "integer", "minimum": 10000000 },
        "packageArtifactId": { "type": "integer", "minimum": 10000000 },
        "packageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "catalogSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "administratorIdentityResourceIdSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "serverResourceIdSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "databaseName": { "const": "AdventuresSuiteDevelopment" },
        "privateEndpointResourceIdSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "outcome": { "enum": ["complete", "At0006", "absent", "unexpected", "ambiguous"] },
    "journal": { "type": "object", "additionalProperties": false, "required": ["exists", "scripts"], "properties": { "exists": { "type": "boolean" }, "scripts": { "type": "array", "maxItems": 12, "items": { "enum": ["0001_create_planning_schema.sql", "0002_create_adventure_plans.sql", "0003_create_planning_children.sql", "0004_create_authentication_persistence.sql", "0005_bind_sessions_to_external_identities.sql", "0006_create_creator_memberships.sql", "0007_create_traveler_participations.sql", "0008_create_companion_read_role.sql", "0009_create_adventure_plan_create_results.sql", "0010_create_companion_policy_assignments.sql", "0011_create_adventure_plan_template_origins.sql", "0012_create_planner_footstep_applications.sql"] } } } },
    "schemas": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/namedOwner" } },
    "roles": { "type": "array", "maxItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["name", "owner", "memberSidSha256"], "properties": { "name": { "enum": ["AdventuresSuiteAuthenticationRuntime", "AdventuresSuiteMembershipRuntime", "AdventuresSuiteCompanionReadRuntime", "AdventuresSuiteCompanionPolicyRuntime", "AdventuresSuitePlanningRuntime"] }, "owner": { "enum": ["dbo", "unexpected-redacted"] }, "memberSidSha256": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9A-F]{64}$" } } } } },
    "principals": { "type": "array", "maxItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "type", "authenticationType", "sidSha256"], "properties": { "name": { "const": "AdventuresSuiteMigrationDev-ffc9a" }, "type": { "type": "string", "maxLength": 40 }, "authenticationType": { "type": "string", "maxLength": 40 }, "sidSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" } } } },
    "permissions": { "type": "array", "maxItems": 168, "items": { "type": "object", "additionalProperties": false, "required": ["grantee", "state", "permission", "class", "securable"], "properties": { "grantee": { "enum": ["AdventuresSuiteMigrationDev-ffc9a", "AdventuresSuiteAuthenticationRuntime", "AdventuresSuiteMembershipRuntime", "AdventuresSuiteCompanionReadRuntime", "AdventuresSuiteCompanionPolicyRuntime", "AdventuresSuitePlanningRuntime"] }, "state": { "enum": ["GRANT", "DENY", "GRANT_WITH_GRANT_OPTION"] }, "permission": { "enum": ["CONNECT", "CREATE TABLE", "VIEW DEFINITION", "CONTROL", "SELECT", "INSERT", "UPDATE", "DELETE", "ALTER", "REFERENCES", "EXECUTE", "ALTER ANY USER", "ALTER ANY ROLE", "CREATE USER", "CREATE ROLE", "CREATE SCHEMA", "unexpected-redacted"] }, "class": { "enum": ["DATABASE", "SCHEMA", "OBJECT_OR_COLUMN", "DATABASE_PRINCIPAL", "unexpected-redacted"] }, "securable": { "enum": [null, "AdventuresSuiteDevelopment", "[dbo]", "[planning]", "[auth]", "[audit]", "[dbo].[AdventuresSuiteSchemaVersions]", "[audit].[AuditEvents]", "[audit].[CompanionInformationPolicyAssignmentEvents]", "[auth].[CreatorMembershipPermissionGrants]", "[auth].[CreatorMembershipRoles]", "[auth].[CreatorMemberships]", "[auth].[ExternalIdentities]", "[auth].[UserSessions]", "[auth].[Users]", "[planning].[Accommodations]", "[planning].[AdventurePlanCreateResults]", "[planning].[AdventurePlanTemplateOrigins]", "[planning].[AdventurePlans]", "[planning].[BudgetItems]", "[planning].[CompanionInformationPolicyAssignments]", "[planning].[DestinationVisits]", "[planning].[ItineraryDays]", "[planning].[PackingItems]", "[planning].[PlannedActivities]", "[planning].[PlannerFootStepApplications]", "[planning].[PlanningNotes]", "[planning].[PlanningTasks]", "[planning].[Reservations]", "[planning].[TransportationSegments]", "[planning].[TravelerParticipations]", "[planning].[TravelerPreferences]", "[planning].[Travelers]", "[AdventuresSuiteAuthenticationRuntime]", "[AdventuresSuiteMembershipRuntime]", "[AdventuresSuiteCompanionReadRuntime]", "[AdventuresSuiteCompanionPolicyRuntime]", "[AdventuresSuitePlanningRuntime]", "[AdventuresSuiteMigrationDev-ffc9a]", "unexpected-redacted"] } } } },
    "objectCounts": { "type": "array", "maxItems": 24, "items": { "type": "object", "additionalProperties": false, "required": ["schema", "type", "count"], "properties": { "schema": { "enum": ["dbo", "planning", "auth", "audit"] }, "type": { "type": "string", "maxLength": 64 }, "count": { "type": "integer", "minimum": 0, "maximum": 10000 } } } },
    "residue": { "type": "object", "additionalProperties": false, "required": ["resourceCount", "registrationCount", "temporaryAssignmentCount", "guestFileCount"], "properties": { "resourceCount": { "const": 0 }, "registrationCount": { "const": 0 }, "temporaryAssignmentCount": { "const": 0 }, "guestFileCount": { "const": 0 } } }
  },
  "$defs": { "namedOwner": { "type": "object", "additionalProperties": false, "required": ["name", "owner"], "properties": { "name": { "enum": ["planning", "auth", "audit"] }, "owner": { "enum": ["db_ddladmin", "unexpected-redacted"] } } } }
}
