@implements IDisposable
@inject TransientBackNavigationService BackNavigation

<div class="memory-adventure-selector" @onkeydown="HandleKeyDown">
    <span id="memory-adventure-label" class="selector-label">Adventure</span>
    <button @ref="_trigger"
            class="memory-adventure-trigger"
            type="button"
            aria-labelledby="memory-adventure-label memory-adventure-value"
            aria-haspopup="listbox"
            aria-expanded="@SelectorState.IsOpen"
            @onclick="ToggleAsync">
        <span id="memory-adventure-value">@SelectedAdventure.Title</span>
        <b aria-hidden="true">@(SelectorState.IsOpen ? "⌃" : "⌄")</b>
    </button>
    @if (SelectorState.IsOpen)
    {
        <button class="selector-scrim" type="button" tabindex="-1" aria-label="Close Adventure selector" @onclick="DismissAsync"></button>
        <div class="memory-adventure-options" role="listbox" aria-labelledby="memory-adventure-label">
            @foreach (var adventure in Adventures)
            {
                <button type="button"
                        role="option"
                        aria-selected="@(adventure.Id == SelectedAdventure.Id)"
                        class="@(adventure.Id == SelectedAdventure.Id ? "selected" : null)"
                        @onclick="() => SelectAsync(adventure)">
                    <span><strong>@adventure.Title</strong><small>@adventure.TravelDates</small></span>
                    <b aria-hidden="true">@(adventure.Id == SelectedAdventure.Id ? "✓" : "")</b>
                </button>
            }
        </div>
    }
</div>

@code {
    private ElementReference _trigger;
    private TransientSelectorState<CompanionAdventure>? _selectorState;

    private TransientSelectorState<CompanionAdventure> SelectorState =>
        _selectorState ??= new TransientSelectorState<CompanionAdventure>(BackNavigation);

    /// <summary>Gets or sets the Adventures available to the traveler.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<CompanionAdventure> Adventures { get; set; } = [];

    /// <summary>Gets or sets the Adventure whose memories are shown.</summary>
    [Parameter, EditorRequired]
    public CompanionAdventure SelectedAdventure { get; set; } = null!;

    /// <summary>Gets or sets the callback that commits a selection.</summary>
    [Parameter]
    public EventCallback<CompanionAdventure> SelectedAdventureChanged { get; set; }

    private async Task ToggleAsync()
    {
        if (SelectorState.IsOpen)
        {
            await DismissAsync();
            return;
        }

        SelectorState.Open(DismissAsync);
    }

    private async Task SelectAsync(CompanionAdventure adventure)
    {
        await SelectorState.SelectAsync(
            adventure,
            selected => SelectedAdventureChanged.InvokeAsync(selected),
            RenderClosedAsync,
            RestoreFocusAsync);
    }

    private async Task DismissAsync()
    {
        await SelectorState.DismissAsync(RenderClosedAsync, RestoreFocusAsync);
    }

    private Task HandleKeyDown(KeyboardEventArgs args) => args.Key == "Escape" && SelectorState.IsOpen
        ? DismissAsync()
        : Task.CompletedTask;

    private Task RenderClosedAsync() => InvokeAsync(StateHasChanged);

    private async Task RestoreFocusAsync() => await _trigger.FocusAsync();

    /// <inheritdoc />
    public void Dispose()
    {
        _selectorState?.Dispose();
    }
}
